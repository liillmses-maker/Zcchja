local function GetRoomName(pos)
    if not pos then return "Unknown" end
    for _, room in ipairs(ROOMS) do
        if pos.X >= room.min.X and pos.X <= room.max.X and
           pos.Y >= room.min.Y and pos.Y <= room.max.Y and
           pos.Z >= room.min.Z and pos.Z <= room.max.Z then
            return room.name
        end
    end
    return "Unknown"
end

