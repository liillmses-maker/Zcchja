local function DrawOutline(pos2D, size2D, color, hash)
    local x = pos2D.X - size2D.X/2
    local y = pos2D.Y - size2D.Y/2
    local w = size2D.X
    local h = size2D.Y
    
    local pulse = 1 + math.sin(Time * 2 + hash * 0.01) * 0.04
    
    local top = GetLine()
    top.From = Vector2.new(x, y)
    top.To = Vector2.new(x + w, y)
    top.Color = color
    top.Thickness = 1.8 * pulse
    top.Visible = true
    
    local bottom = GetLine()
    bottom.From = Vector2.new(x, y + h)
    bottom.To = Vector2.new(x + w, y + h)
    bottom.Color = color
    bottom.Thickness = 1.8 * pulse
    bottom.Visible = true
    
    local left = GetLine()
    left.From = Vector2.new(x, y)
    left.To = Vector2.new(x, y + h)
    left.Color = color
    left.Thickness = 1.8 * pulse
    left.Visible = true
    
    local right = GetLine()
    right.From = Vector2.new(x + w, y)
    right.To = Vector2.new(x + w, y + h)
    right.Color = color
    right.Thickness = 1.8 * pulse
    right.Visible = true
    
    -- Corner accents (small extra lines for style)
    local cornerLen = math.min(w, h) * 0.2
    
    -- Top-left corner accent
    local tl1 = GetLine()
    tl1.From = Vector2.new(x - 2, y - 2)
    tl1.To = Vector2.new(x + cornerLen, y - 2)
