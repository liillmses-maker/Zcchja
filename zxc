local function IsBodyPart(n)
    for _,bp in ipairs(BODY_PARTS) do if n==bp then return true end end
    return false
end

local function GetState(o)
    if o:IsA("BasePart") then
        return {p=o.Position, r=o.Orientation, s=o.Size, c=o.Color, t=o.Transparency, m=o.Material, a=o.Anchored}
    elseif o:IsA("Model") then
        local pp = o:FindFirstChildOfClass("BasePart") or o.PrimaryPart
        if pp then return {p=pp.Position, r=pp.Orientation, s=pp.Size} end
    end
    return nil
end

local function HasChanged(old,new)
    if not old or not new then return true end
    if old.p and new.p and (old.p-new.p).Magnitude>0.1 then return true end
    if old.r and new.r and (old.r-new.r).Magnitude>0.5 then return true end
    if old.s and new.s and (old.s-new.s).Magnitude>0.1 then return true end
    if old.c and new.c and old.c~=new.c then return true end
    if old.t and new.t and math.abs(old.t-new.t)>0.01 then return true end
    if old.m and new.m and old.m~=new.m then return true end
    if old.a~=nil and new.a~=nil and old.a~=new.a then return true end
    return false
end

local function GetChangeType(old,new)
    local changes = {}
    if old.p and new.p and (old.p-new.p).Magnitude>0.1 then table.insert(changes,"MOVED") end
    if old.r and new.r and (old.r-new.r).Magnitude>0.5 then table.insert(changes,"ROTATED") end
    if old.s and new.s and (old.s-new.s).Magnitude>0.1 then table.insert(changes,"RESIZED") end
    if old.c and new.c and old.c~=new.c then table.insert(changes,"COLOR") end
    if old.m and new.m and old.m~=new.m then table.insert(changes,"MATERIAL") end
    return #changes>0 and table.concat(changes,"+") or "CHANGED"
end

-- ================== MAIN LOOP ==================
RunService.RenderStepped:Connect(function(dt)
    -- ========== ESP RENDER ==========
    if MasterOn and (Settings.AnomalyESP or Settings.ObjectESP or Settings.ChangesESP) then
        ESPLastScan = ESPLastScan + dt
        if ESPLastScan >= ESPInterval then
            ESPLastScan = 0
            DetectedESP = {}
            for _,obj in ipairs(workspace:GetDescendants()) do
                if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
                local name = obj.Name
                local ok = false; local col = C.PINK_ESP
                
                if Settings.AnomalyESP and InList(name,ANOMALY_NAMES) then
                    ok=true; col=C.RED
                elseif Settings.ObjectESP and InList(name,OBJECT_NAMES) then
                    ok=true; col=C.PINK_ESP
                elseif Settings.ChangesESP then
                    local p = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
                    if p and p:IsA("BasePart") and (p.Velocity.Magnitude>0.1 or p.RotVelocity.Magnitude>0.1) then
                        ok=true; col=C.YELLOW
                    end
                end
                
                if ok then DetectedESP[obj] = col end
            end
        end
        
        -- Draw ESP
        for _,l in ipairs(LinePool) do l.Visible=false end
        for obj,col in pairs(DetectedESP) do
            if obj and obj.Parent then
                if obj:IsA("Model") then
                    for _,c in ipairs(obj:GetDescendants()) do
                        if c:IsA("BasePart") then DrawWireframe(c,col) end
                    end
                elseif obj:IsA("BasePart") then
                    DrawWireframe(obj,col)
                end
            end
        end
    else
        for _,l in ipairs(LinePool) do l.Visible=false end
    end
    
    -- ========== SCANNER ==========
    if not Settings.Scanner then
        if MasterOn then Status.Text="uwu on" else Status.Text="uwu zzz..." end
        return
    end
    
    ScannerLastScan = ScannerLastScan + dt
    LastCopy = LastCopy + dt
    LastSoundCheck = LastSoundCheck + dt
    LastClockCheck = LastClockCheck + dt
    LastFaceCheck = LastFaceCheck + dt
    
    -- Sound detector
    if Settings.DetectSounds and LastSoundCheck>=1 then
        LastSoundCheck = 0
        for _,o in ipairs(workspace:GetDescendants()) do
            if o:IsA("Sound") and o.IsPlaying and o.Volume>0.05 then
                local id = o:GetFullName()
                if not SoundReported[id] then
                    SoundReported[id] = true
                    local room = GetRoomName(o)
                    local sn = o.SoundId:match("([^/]+)$") or o.SoundId
                    local msg = "[S] ["..room.."] "..sn
                    table.insert(CopiedChanges,msg)
                    AddLog(msg,C.CYAN)
                end
            end
        end
        for id in pairs(SoundReported) do
            local o = workspace:FindFirstChild(id)
            if not o or not o:IsA("Sound") or not o.IsPlaying then SoundReported[id]=nil end
        end
    end
    
    -- Clock detector
    if Settings.DetectClock and LastClockCheck>=0.5 then
        LastClockCheck = 0
        local ct = Lighting.ClockTime
        local td = math.abs(ct-PrevClockTime)
        if td>0.08 then
            local msg = "[CLOCK] x"..math.floor(td/0.03)
            table.insert(CopiedChanges,msg)
            AddLog(msg,Color3.new(1,0.59,0.2))
        end
        PrevClockTime = ct
    end
    
    -- Face detector
    if Settings.DetectFaces and LastFaceCheck>=0.5 then
        LastFaceCheck = 0
        for _,o in ipairs(workspace:GetDescendants()) do
            local nm = o.Name:lower()
            if nm:find("annoying") or nm:find("orange") or nm:find("painting") or nm:find("mona") then
                local hd = false
                for _,ch in ipairs(o:GetDescendants()) do
                    if ch:IsA("Decal") or ch:IsA("Texture") then hd=true; break end
                end
                if hd and not o:GetAttribute("FR") then
                    o:SetAttribute("FR",true)
                    local room = GetRoomName(o)
                    local msg = "[FACE] ["..room.."] "..o.Name
                    table.insert(CopiedChanges,msg)
                    AddLog(msg,Color3.new(1,0.39,1))
                end
            end
        end
    end
    
    -- Object scanner
    if ScannerLastScan >= ScannerInterval then
        ScannerLastScan = 0
        local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        local CurrentObjects = {}
        for _,o in ipairs(workspace:GetDescendants()) do
            if not (o:IsA("Model") or o:IsA("BasePart")) then continue end
            if o:IsA("BasePart") and o.Transparency>0.95 then continue end
            if o.Name=="Terrain" then continue end
            if IsBodyPart(o.Name) then continue end
            
            local pp = o:IsA("BasePart") and o or o:FindFirstChildOfClass("BasePart")
            if not pp then continue end
            if (pp.Position-root.Position).Magnitude > ScanRange then continue end
            
            local st = GetState(o)
            if not st then continue end
            CurrentObjects[o] = st
            
            if ObjectDB[o] and HasChanged(ObjectDB[o],st) then
                local room = GetRoomName(o)
                local changeType = GetChangeType(ObjectDB[o],st)
                local msg = "["..room.."] "..o.Name..": "..changeType
                table.insert(CopiedChanges,msg)
                AddLog(msg,C.YELLOW)
            end
        end
        
        -- Removed objects
        for o in pairs(ObjectDB) do
            if not CurrentObjects[o] and not IsBodyPart(o.Name) then
                local room = GetRoomName(o)
                local msg = "[-] ["..room.."] "..o.Name
                table.insert(CopiedChanges,msg)
                AddLog(msg,C.RED)
            end
        end
        
        ObjectDB = CurrentObjects
        
        -- Auto copy
        if Settings.AutoCopy and #CopiedChanges>0 and LastCopy>=5 and setclipboard then
            LastCopy = 0
            local seen = {}
            local text = ""
            for _,v in ipairs(CopiedChanges) do
                if not seen[v] then seen[v]=true; text=text..v.."\n" end
            end
            setclipboard(text)
            CopiedChanges = {}
            Status.Text = "copied!"
            Status.TextColor3 = C.GREEN
            spawn(function() wait(2) Status.TextColor3=C.GRAY end)
        end
        
        local total = 0
        for _ in pairs(ObjectDB) do total=total+1 end
        Status.Text = "~"..total.." obj"
    end
end)
