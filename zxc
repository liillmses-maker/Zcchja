for _,v in ipairs(workspace:GetDescendants()) do Cached[v]=true end
workspace.DescendantAdded:Connect(function(v) Cached[v]=true end)
workspace.DescendantRemoving:Connect(function(v) Cached[v]=nil; ObjectDB[v]=nil; ODB2[v]=nil end)

local function InList(n,l) for _,k in ipairs(l) do if n==k then return true end end; return false end

local function GetState(o)
    if o:IsA("BasePart") then return{p=o.Position,s=o.Size,c=o.Color,t=o.Transparency,m=o.Material} end
    local pp=o:FindFirstChildOfClass("BasePart")or o.PrimaryPart
    if pp then return{p=pp.Position,s=pp.Size} end
    return nil
end

function GetCircle()
    if not Drawing then return nil end
    for _,c in ipairs(CirclePool) do if not c.Visible then return c end end
    local c=Drawing.new("Circle"); c.Thickness=2; c.Filled=false; c.Transparency=1; c.NumSides=32
    table.insert(CirclePool,c); return c
end

RunService.RenderStepped:Connect(function(dt)
    AnimTime=AnimTime+dt
    
    -- ESP
    if MasterOn and(Settings.ShowAnomaly or Settings.ShowObject or Settings.ShowChanges) then
        ESPLastScan=ESPLastScan+dt
        if ESPLastScan>=0.3 then ESPLastScan=0; DetectedESP={}
            for _,o in ipairs(workspace:GetDescendants()) do
                if not Cached[o] then continue end
                if not(o:IsA("Model")or o:IsA("BasePart"))then continue end
                local nm=o.Name; local ok=false; local col=C.PINK_ESP
                if Settings.ShowAnomaly and InList(nm,ANOMALY_NAMES) then ok=true; col=C.RED
                elseif Settings.ShowObject and InList(nm,OBJECT_NAMES) then ok=true; col=C.PINK_ESP
                elseif Settings.ShowChanges then
                    local p=o:IsA("BasePart")and o or o:FindFirstChildOfClass("BasePart")
                    if p and p:IsA("BasePart")and(p.AssemblyLinearVelocity.Magnitude>0.1 or p.RotVelocity.Magnitude>0.1) then ok=true; col=C.YELLOW end
                end
                if ok then
                    local r=5
                    if o:IsA("BasePart")then r=math.clamp(math.max(o.Size.X,o.Size.Y,o.Size.Z)*0.7,4,35)
                    elseif o:IsA("Model")then local pp=o:FindFirstChildOfClass("BasePart")or o.PrimaryPart; if pp then r=math.clamp(math.max(pp.Size.X,pp.Size.Y,pp.Size.Z)*0.7,4,35) end end
                    DetectedESP[o]={col=col,r=r}
                end
            end
        end
        for _,c in ipairs(CirclePool) do c.Visible=false end
        for o,d in pairs(DetectedESP) do
            if o and o.Parent then
                local p=o:IsA("BasePart")and o or o:FindFirstChildOfClass("BasePart")
                if p then
                    local pos,on=Camera:WorldToViewportPoint(p.Position)
                    if on then
                        local cr=GetCircle()
                        if cr then
                            local seed=string.byte(o.Name,1) or 1
                            cr.Position=Vector2.new(pos.X,pos.Y)
                            cr.Radius=d.r*(1+math.sin(AnimTime*2+seed)*0.04)
                            cr.Color=d.col
                            cr.Visible=true
                        end
                    end
                end
            end
        end
    else
        for _,c in ipairs(CirclePool) do c.Visible=false end
    end
    
    -- SKIN DETECT
    if MasterOn and Settings.ShowSkinDetect then
        for o,st in pairs(ODB2) do
            if o and o.Parent and o:IsA("BasePart") then
                local newSt=GetState(o)
                if newSt then
                    if st.c~=newSt.c then
                        local rm=GetRoomName(o)
                        local msg="[SKIN] ["..rm.."] "..o.Name.." color"
                        ShowNotif("SKIN CHANGE",o.Name.." color",C.PINK)
                        AddLog(msg,C.PINK)
                    end
                    if st.m~=newSt.m then
                        local rm=GetRoomName(o)
                        local msg="[SKIN] ["..rm.."] "..o.Name.." material"
                        ShowNotif("SKIN CHANGE",o.Name.." material",C.PINK)
                        AddLog(msg,C.PINK)
                    end
                end
            end
        end
        for _,o in ipairs(workspace:GetDescendants()) do
            if o:IsA("BasePart") and Cached[o] then ODB2[o]=GetState(o) end
        end
    end
    
    -- SIZE DETECT
    if MasterOn and Settings.ShowSizeDetect then
        for o,st in pairs(ObjectDB) do
            if o and o.Parent and o:IsA("BasePart") then
                local newSt=GetState(o)
                if newSt and(st.s-newSt.s).Magnitude>0.1 then
                    local rm=GetRoomName(o)
                    local msg="[SIZE] ["..rm.."] "..o.Name.." resized"
                    ShowNotif("SIZE CHANGE",o.Name,C.YELLOW)
                    AddLog(msg,C.YELLOW)
                end
            end
        end
        for _,o in ipairs(workspace:GetDescendants()) do
            if o:IsA("BasePart") and Cached[o] then ObjectDB[o]=GetState(o) end
        end
    end
    
    if MasterOn then Status.Text="uwu on" else Status.Text="uwu zzz..." end
end)
