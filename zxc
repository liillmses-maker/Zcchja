-- ================== ESP RENDER ==================
if Drawing then
    local Circles = {}
    local Texts = {}
    
    function GetCircle()
        for _, c in ipairs(Circles) do if not c.Visible then return c end end
        local c = Drawing.new("Circle")
        c.Thickness = 2
        c.Filled = false
        c.Transparency = 1
        c.NumSides = 40
        table.insert(Circles, c)
        return c
    end
    
    function GetText()
        for _, t in ipairs(Texts) do if not t.Visible then return t end end
        local t = Drawing.new("Text")
        t.Size = 12
        t.Center = true
        t.Outline = true
        t.OutlineColor = Color3.new()
        table.insert(Texts, t)
        return t
    end
    
    RunService.RenderStepped:Connect(function()
        for _, c in ipairs(Circles) do c.Visible = false end
        for _, t in ipairs(Texts) do t.Visible = false end
        
        local root = getRoot()
        if not root then return end
        
        for obj, meta in pairs(ECS.components.Meta) do
            if not obj.Parent then continue end
            if meta.type ~= "INTRUDER" and meta.type ~= "VISUAL" then continue end
            
            local part = getPart(obj)
            if not part then continue end
            
            local dist = (part.Position - root.Position).Magnitude
            if dist > 200 then continue end
            
            local pos, on = Camera:WorldToViewportPoint(part.Position)
            if not on then continue end
            
            local cr = GetCircle()
            local txt = GetText()
            if cr and txt then
                local r = math.clamp(math.max(part.Size.X, part.Size.Y, part.Size.Z) * 0.8, 5, 30)
                local col = meta.type == "INTRUDER" and Theme.RED or Theme.YELLOW
                cr.Position = Vector2.new(pos.X, pos.Y)
                cr.Radius = r
                cr.Color = col
                cr.Visible = true
                txt.Position = Vector2.new(pos.X, pos.Y - r - 14)
                txt.Text = meta.type .. ": " .. obj.Name .. "\n" .. math.floor(dist) .. "m"
                txt.Color = Theme.TEXT
                txt.Visible = true
            end
        end
    end)
end

