-- ================== NPC ESP (RED CIRCLES ONLY, NO MOVEMENT ESP) ==================
local NPCs = {}

local function IsNPC(obj)
    if obj:IsA("Model") then
        if obj:FindFirstChildOfClass("Humanoid") then return true end
        if obj:FindFirstChild("HumanoidRootPart") then return true end
    end
    return false
end

local function GetPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end
    return nil
end

workspace.DescendantAdded:Connect(function(obj)
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
    if obj == Player.Character then return end
    if IsNPC(obj) then NPCs[obj] = true end
end)

workspace.DescendantRemoving:Connect(function(obj) NPCs[obj] = nil end)

-- Initial NPC scan
task.defer(function()
    task.wait(1)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if IsNPC(obj) and obj ~= Player.Character then NPCs[obj] = true end
    end
end)

-- NPC ESP Render (RED circles + distance text only)
if Drawing then
    local Circles = {}; local Texts = {}
    function GetCircle()
        for _, c in ipairs(Circles) do if not c.Visible then return c end end
        local c = Drawing.new("Circle") c.Thickness = 2; c.Filled = false; c.Transparency = 1; c.NumSides = 40; table.insert(Circles, c); return c
    end
    function GetText()
        for _, t in ipairs(Texts) do if not t.Visible then return t end end
        local t = Drawing.new("Text") t.Size = 13; t.Center = true; t.Outline = true; t.OutlineColor = Color3.new(); table.insert(Texts, t); return t
    end
    
    RunService.RenderStepped:Connect(function()
        for _, c in ipairs(Circles) do c.Visible = false end
        for _, t in ipairs(Texts) do t.Visible = false end
        
        local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        for obj in pairs(NPCs) do
            if not obj.Parent then NPCs[obj] = nil; continue end
            local part = GetPart(obj); if not part then continue end
            local dist = (part.Position - root.Position).Magnitude; if dist > 300 then continue end
            local pos, on = Camera:WorldToViewportPoint(part.Position); if not on then continue end
            
            local cr = GetCircle(); local txt = GetText()
            if cr then
                local r = math.clamp(math.max(part.Size.X, part.Size.Y, part.Size.Z) * 0.8, 5, 35)
                cr.Position = Vector2.new(pos.X, pos.Y); cr.Radius = r; cr.Color = Theme.RED; cr.Visible = true
                txt.Position = Vector2.new(pos.X, pos.Y - r - 14)
                txt.Text = "NPC: " .. obj.Name .. "\n" .. math.floor(dist) .. "m"
                txt.Color = Color3.fromRGB(255, 255, 255); txt.Visible = true
            end
        end
    end)
end

