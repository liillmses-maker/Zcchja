local ANOMALY_NAMES = {"Alternate","HallwayIntruder","Devil","Mask","Dummy","Mannequin","BloodPart","Pentagram","Eyes","Jumpscares","N","Intruder","Monster","Creature","Entity"}
local OBJECT_NAMES = {"AnnoyingOrange","NormalOrange","Orange","Float Duck","Duck","Crib","Rockingmachine","Bar Soap","Soap","Mirror","Sink","Curtain","Bucket","TV","Telephone","Alarm Clock","WallClock","ClockFace","Whiteboard","To-Do-List","StickyNotes","Papers","Paper","Books","Open Book","Poster","Painting","MonaLisa","WallDrawing","Frame","Monitor","Screen","Keyboard","Mouse","Carpet","Chair","Table","RoundTable","Pool Table","Desk","Shelf","Shoe Rack","Shoes","Wardrobe","Closet","Door","Window","Fridge","Oven","Frying Pan","Cup","g Cup","CoffeeJar","SugarJar","Container","Cola","ToiletPaperRoll","ToiletPlunger","Trash Can","Trash Bag","Suitcase","Briefcase","Box","Cardboard","Tire","Plant","Vase","Light","Lamp","Neon","Figurine","Bed","Pillow","Glass","Bleach","crayon","pic1","pic2","pic3","Projector"}

local Detected = {}
local Circles = {}
local LastScan = 0
local Time = 0

function GetCircle()
    for _, c in ipairs(Circles) do
        if not c.Visible then return c end
    end
    local c = Drawing.new("Circle")
    c.Thickness = 2
    c.Filled = false
    c.Transparency = 1
    c.NumSides = 32
    table.insert(Circles, c)
    return c
end

local function InList(name, list)
    for _, k in ipairs(list) do if name == k then return true end end
    return false
end

RunService.RenderStepped:Connect(function(dt)
    Time = Time + dt
    
    if MasterOn and (Settings.ShowAnomaly or Settings.ShowObject or Settings.ShowChanges) then
        LastScan = LastScan + dt
        if LastScan >= 0.3 then
            LastScan = 0
            Detected = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
                local name = obj.Name
                local ok = false
                local col = C.PINK_ESP
                
                if Settings.ShowAnomaly and InList(name, ANOMALY_NAMES) then
                    ok = true; col = C.RED
                elseif Settings.ShowObject and InList(name, OBJECT_NAMES) then
                    ok = true; col = C.PINK_ESP
                elseif Settings.ShowChanges then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
                    if part and part:IsA("BasePart") then
                        if part.AssemblyLinearVelocity.Magnitude > 0.1 or part.RotVelocity.Magnitude > 0.1 then
                            ok = true; col = C.YELLOW
                        end
                    end
                end
                
                if ok then
                    local radius = 5
                    if obj:IsA("BasePart") then
                        radius = math.clamp(math.max(obj.Size.X, obj.Size.Y, obj.Size.Z) * 0.7, 4, 35)
                    elseif obj:IsA("Model") then
                        local pp = obj:FindFirstChildOfClass("BasePart") or obj.PrimaryPart
                        if pp then radius = math.clamp(math.max(pp.Size.X, pp.Size.Y, pp.Size.Z) * 0.7, 4, 35) end
                    end
                    Detected[obj] = {col = col, r = radius}
                end
            end
        end
        
        for _, c in ipairs(Circles) do c.Visible = false end
        
        for obj, data in pairs(Detected) do
            if obj and obj.Parent then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
                if part then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local circle = GetCircle()
                        if circle then
                            local seed = string.byte(obj.Name, 1) or 1
                            circle.Position = Vector2.new(pos.X, pos.Y)
                            circle.Radius = data.r * (1 + math.sin(Time * 2 + seed) * 0.04)
                            circle.Color = data.col
                            circle.Visible = true
                        end
                    end
                end
            end
        end
    else
        for _, c in ipairs(Circles) do c.Visible = false end
    end
    
    if MasterOn then StatusText.Text = "uwu on" else StatusText.Text = "uwu zzz..." end
end)

-- ================== SCANNER ==================
local ObjectDB = {}
local ObjectDB2 = {}

workspace.DescendantRemoving:Connect(function(v)
    ObjectDB[v] = nil
    ObjectDB2[v] = nil
end)

spawn(function()
    while true do
        wait(0.5)
        if MasterOn and Settings.Scanner then
            -- Skin detect
            if Settings.SkinDetect then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        local st = {c = obj.Color, m = obj.Material}
                        if ObjectDB2[obj] then
                            if ObjectDB2[obj].c ~= st.c then
                                ShowNotif("SKIN", obj.Name .. " color changed", C.PINK)
                                AddLog("[SKIN] " .. obj.Name .. " color", C.PINK)
                            end
                            if ObjectDB2[obj].m ~= st.m then
                                ShowNotif("SKIN", obj.Name .. " material changed", C.PINK)
                                AddLog("[SKIN] " .. obj.Name .. " material", C.PINK)
                            end
                        end
                        ObjectDB2[obj] = st
                    end
                end
            end
            
            -- Size detect
            if Settings.SizeDetect then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        local st = {s = obj.Size}
                        if ObjectDB[obj] and (ObjectDB[obj].s - st.s).Magnitude > 0.1 then
                            ShowNotif("SIZE", obj.Name .. " resized", C.YELLOW)
                            AddLog("[SIZE] " .. obj.Name .. " changed", C.YELLOW)
                        end
                        ObjectDB[obj] = st
                    end
                end
            end
            
            StatusText.Text = "~scanning"
        end
    end
end)
