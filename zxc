-- ================== STATE LAYER ==================
local State = {}
State.__index = State
function State.new(obj) return setmetatable({obj=obj,last=nil,dirty=false,lastUpdate=tick(),lastFix=0},State) end
function State:Snapshot(data) self.last=data;self.lastUpdate=tick();self.dirty=false end
function State:MarkDirty() self.dirty=true end
function State:Repair() if tick()-self.lastFix<1 then return end;local part=self.obj:IsA("BasePart")and self.obj or self.obj:FindFirstChildWhichIsA("BasePart");if part and self.last then self.last.pos=part.Position;self.last.size=part.Size;self.lastFix=tick()end end

