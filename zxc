local function IsBodyPart(n)
    for _,b in ipairs(BODY_PARTS) do if n==b then return true end end
    return false
end

local function GetObjectState(obj)
    if obj:IsA("BasePart") then
        return {
            pos = obj.Position, rot = obj.Orientation, size = obj.Size,
            color = obj.Color, transparency = obj.Transparency,
            material = obj.Material, anchored = obj.Anchored
        }
    elseif obj:IsA("Model") then
        local part = obj:FindFirstChildOfClass("BasePart") or obj.PrimaryPart
        if part then return {pos = part.Position, rot = part.Orientation, size = part.Size} end
    end
    return nil
end

local function HasStateChanged(old, new)
    if not old or not new then return true end
    if old.pos and new.pos and (old.pos - new.pos).Magnitude > 0.1 then return true end
    if old.rot and new.rot and (old.rot - new.rot).Magnitude > 0.5 then return true end
    if old.size and new.size and (old.size - new.size).Magnitude > 0.1 then return true end
    if old.color and new.color and old.color ~= new.color then return true end
    if old.transparency and new.transparency and math.abs(old.transparency - new.transparency) > 0.01 then return true end
    if old.material and new.material and old.material ~= new.material then return true end
    if old.anchored ~= nil and new.anchored ~= nil and old.anchored ~= new.anchored then return true end
    return false
end

local function GetChangeType(old, new)
    local changes = {}
    if old.pos and new.pos and (old.pos - new.pos).Magnitude > 0.1 then table.insert(changes, "MOVED") end
    if old.rot and new.rot and (old.rot - new.rot).Magnitude > 0.5 then table.insert(changes, "ROTATED") end
    if old.size and new.size and (old.size - new.size).Magnitude > 0.1 then table.insert(changes, "RESIZED") end
    if old.color and new.color and old.color ~= new.color then table.insert(changes, "COLOR") end
    if old.material and new.material and old.material ~= new.material then table.insert(changes, "MATERIAL") end
    return #changes > 0 and table.concat(changes, "+") or "CHANGED"
end

