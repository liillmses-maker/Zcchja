workspace.DescendantAdded:Connect(function(obj)
    if not MasterOn then return end
    if not(obj:IsA("Model")or obj:IsA("BasePart"))then return end
    if obj:IsA("BasePart")and obj.Transparency>0.95 then return end
    local st=GetState(obj); if st then ObjectCache[obj]=st end
    if IsNPC(obj) then NPCObjects[obj]={name=obj.Name,time=tick()}
    elseif Settings.ItemMode then ItemObjects[obj]={st=st,changed=false,time=tick(),name=obj.Name,ctype="NEW"} end
end)

workspace.DescendantRemoving:Connect(function(obj)
    NPCObjects[obj]=nil; ItemObjects[obj]=nil; ObjectCache[obj]=nil
end)

spawn(function()
    while true do wait(0.4)
        if MasterOn and Settings.ItemMode then
            for obj,data in pairs(ItemObjects) do
                if obj and obj.Parent then
                    local st=GetState(obj)
                    if st and data.st then if HasChanged(data.st,st) then data.changed=true; data.ctype=GetChangeType(data.st,st); data.st=st; data.time=tick() end
                    elseif st then data.st=st end
                else ItemObjects[obj]=nil end
            end
            local now=tick(); for obj,data in pairs(ItemObjects) do if not data.changed and now-data.time>5 then ItemObjects[obj]=nil end end
        end
    end
end)

