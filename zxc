local ODB={}; local LSc=0; local LCp=0; local LSo=0; local LCl=0; local LFa=0; local Chg={}; local PCl=Lighting.ClockTime; local SR={}
local BODY_PARTS={"Head","Torso","Left Arm","Right Arm","Left Leg","Right Leg","HumanoidRootPart","LeftFoot","RightFoot","LeftHand","RightHand","LeftLowerArm","LeftLowerLeg","RightLowerArm","RightLowerLeg","LeftUpperArm","LeftUpperLeg","RightUpperArm","RightUpperLeg","UpperTorso","LowerTorso","Body","Handle","Root","Rig","Rig2","Hitobx"}
local function IsBodyPart(n) for _,bp in ipairs(BODY_PARTS) do if n==bp then return true end end; return false end
local function GState(o) if o:IsA("BasePart") then return {p=o.Position,r=o.Orientation,s=o.Size,c=o.Color,t=o.Transparency,m=o.Material,a=o.Anchored} elseif o:IsA("Model") then local pp=o:FindFirstChildOfClass("BasePart")or o.PrimaryPart; if pp then return {p=pp.Position,r=pp.Orientation,s=pp.Size} end end; return nil end
local function Chg(o,n) if not o or not n then return true end; if o.p and n.p and(o.p-n.p).Magnitude>0.1 then return true end; if o.r and n.r and(o.r-n.r).Magnitude>0.5 then return true end; if o.s and n.s and(o.s-n.s).Magnitude>0.1 then return true end; if o.c and n.c and o.c~=n.c then return true end; if o.t and n.t and math.abs(o.t-n.t)>0.01 then return true end; if o.m and n.m and o.m~=n.m then return true end; if o.a~=nil and n.a~=nil and o.a~=n.a then return true end; return false end
local function CT(o,n) local c={}; if o.p and n.p and(o.p-n.p).Magnitude>0.1 then table.insert(c,"MOVED") end; if o.r and n.r and(o.r-n.r).Magnitude>0.5 then table.insert(c,"ROTATED") end; if o.s and n.s and(o.s-n.s).Magnitude>0.1 then table.insert(c,"RESIZED") end; if o.c and n.c and o.c~=n.c then table.insert(c,"COLOR") end; if o.m and n.m and o.m~=n.m then table.insert(c,"MATERIAL") end; return #c>0 and table.concat(c,"+")or"CHANGED" end

RunService.RenderStepped:Connect(function(dt)
    if not Settings.Scanner then if MasterOn then Status.Text="uwu on" else Status.Text="uwu zzz..." end; return end
    LSc=LSc+dt; LCp=LCp+dt; LSo=LSo+dt; LCl=LCl+dt; LFa=LFa+dt
    if Settings.DetectSounds and LSo>=1 then LSo=0
        for _,o in ipairs(workspace:GetDescendants()) do if o:IsA("Sound")and o.IsPlaying and o.Volume>0.05 then local id=o:GetFullName(); if not SR[id] then SR[id]=true; local rm=GetRoomName(o); local sn=o.SoundId:match("([^/]+)$")or o.SoundId; local m="[S] ["..rm.."] "..sn; table.insert(Chg,m); AddLog(m,C.CYAN) end end end
        for id in pairs(SR) do local o=workspace:FindFirstChild(id); if not o or not o:IsA("Sound")or not o.IsPlaying then SR[id]=nil end end
    end
    if Settings.DetectClock and LCl>=0.5 then LCl=0; local ct=Lighting.ClockTime; local td=math.abs(ct-PCl); if td>0.08 then local m="[CLOCK] x"..math.floor(td/0.03); table.insert(Chg,m); AddLog(m,Color3.new(1,0.59,0.2)) end; PCl=ct end
    if Settings.DetectFaces and LFa>=0.5 then LFa=0
        for _,o in ipairs(workspace:GetDescendants()) do local nm=o.Name:lower(); if nm:find("annoying")or nm:find("orange")or nm:find("painting")or nm:find("mona") then local hd=false; for _,ch in ipairs(o:GetDescendants()) do if ch:IsA("Decal")or ch:IsA("Texture") then hd=true; break end end; if hd and not o:GetAttribute("FR") then o:SetAttribute("FR",true); local rm=GetRoomName(o); local m="[FACE] ["..rm.."] "..o.Name; table.insert(Chg,m); AddLog(m,Color3.new(1,0.39,1)) end end end
    end
    if LSc>=0.5 then LSc=0; local rt=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart"); if not rt then return end
        local CO={}; for _,o in ipairs(workspace:GetDescendants()) do if not(o:IsA("Model")or o:IsA("BasePart"))then continue end; if o:IsA("BasePart")and o.Transparency>0.95 then continue end; if o.Name=="Terrain"then continue end; if IsBodyPart(o.Name) then continue end; local pp=o:IsA("BasePart")and o or o:FindFirstChildOfClass("BasePart"); if not pp then continue end; if(pp.Position-rt.Position).Magnitude>ScanRange then continue end; local st=GState(o); if not st then continue end; CO[o]=st
            if ODB[o]and Chg(ODB[o],st) then local rm=GetRoomName(o); local ct=CT(ODB[o],st); local m="["..rm.."] "..o.Name..": "..ct; table.insert(Chg,m); AddLog(m,C.YELLOW) end
        end
        for o in pairs(ODB) do if not CO[o] and not IsBodyPart(o.Name) then local rm=GetRoomName(o); local m="[-] ["..rm.."] "..o.Name; table.insert(Chg,m); AddLog(m,C.RED) end end
        ODB=CO
        if Settings.AutoCopy and #Chg>0 and LCp>=5 and setclipboard then LCp=0; local sn={}; local tx=""; for _,v in ipairs(Chg) do if not sn[v] then sn[v]=true; tx=tx..v.."\n" end end; setclipboard(tx); Chg={}; Status.Text="copied!"; Status.TextColor3=C.GREEN; spawn(function() wait(2) Status.TextColor3=C.GRAY end) end
        local tt=0; for _ in pairs(ODB) do tt=tt+1 end; Status.Text="~"..tt.." obj"
    end
end)
