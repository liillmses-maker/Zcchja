    function GetCircle()
        for _, c in ipairs(Circles) do if not c.Visible then return c end end
        if Drawing then
            local c = Drawing.new("Circle")
            c.Thickness = 2; c.Filled = false; c.Transparency = 1; c.NumSides = 32
            table.insert(Circles, c); return c
        end
        return nil
    end
    
    local function InList(name, list)
        for _, k in ipairs(list) do if name == k then return true end end
        return false
    end
    
    -- ESP Update loop
    spawn(function()
        while Main and Main.Parent do
            wait(0.25)
            if MasterOn and (Settings.ShowAnomaly or Settings.ShowObject or Settings.ShowChanges) then
                Detected = {}
                DetectedNames = {}
                
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
                    local name = obj.Name
                    local ok = false
                    local col = C.PINK_ESP
                    local etype = "OBJECT"
                    
                    -- Check MONSTERS first = RED
                    if Settings.ShowAnomaly and InList(name, MONSTER_NAMES) then
                        ok = true; col = C.RED; etype = "MONSTER"
                    -- Check changed/objects = PINK
                    elseif Settings.ShowObject and InList(name, OBJECT_NAMES) then
                        ok = true; col = C.PINK_ESP; etype = "OBJECT"
                    -- Check active changes = PINK (changed items)
                    elseif Settings.ShowChanges then
                        local p = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
                        if p and p:IsA("BasePart") then
                            local vel = p.AssemblyLinearVelocity or p.Velocity
                            if (vel and vel.Magnitude > 0.1) or (p.RotVelocity and p.RotVelocity.Magnitude > 0.1) then
                                ok = true; col = C.PINK_ESP; etype = "CHANGE"
                            end
                        end
                    end
                    
                    if ok then
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart") or obj.PrimaryPart
                        if part then
                            local room = GetRoomName(part.Position)
                            local r = math.clamp(math.max(part.Size.X, part.Size.Y, part.Size.Z) * 0.7, 4, 35)
                            Detected[obj] = {col = col, r = r, room = room, name = name, etype = etype}
                            
                            if not DetectedNames[name] then
                                DetectedNames[name] = true
                                local icon = etype == "MONSTER" and "R" or "P"
                                AddLog("[" .. icon .. "] [" .. room .. "] " .. etype .. ": " .. name, col)
                            end
                        end
                    end
                end
            end
        end
    end)
    
