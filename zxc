-- Chinese Hat (FIRST PERSON VISIBLE)
local function CreateHat()
    if HatModel then HatModel:Destroy() end
    local char = Player.Character; if not char then return end
    local head = char:FindFirstChild("Head"); if not head then return end
    
    HatModel = Instance.new("Model") HatModel.Name = "ChineseHat"; HatModel.Parent = char
    
    local cone = Instance.new("Part") cone.Name = "HatCone"; cone.Shape = Enum.PartType.Cone
    cone.Size = Vector3.new(2.5, 1.8, 2.5); cone.Position = head.Position + Vector3.new(0, 2, 0)
    cone.Color = Color3.fromRGB(255, 150, 200); cone.Transparency = 0.4; cone.Material = Enum.Material.Glass
    cone.Anchored = false; cone.CanCollide = false; cone.Parent = HatModel
    
    local ball = Instance.new("Part") ball.Name = "HatBall"; ball.Shape = Enum.PartType.Ball
    ball.Size = Vector3.new(0.5, 0.5, 0.5); ball.Position = head.Position + Vector3.new(0, 3.1, 0)
    ball.Color = Color3.fromRGB(255, 100, 150); ball.Transparency = 0.2; ball.Material = Enum.Material.Neon
    ball.Anchored = false; ball.CanCollide = false; ball.Parent = HatModel
    
    local brim = Instance.new("Part") brim.Name = "HatBrim"; brim.Shape = Enum.PartType.Cylinder
    brim.Size = Vector3.new(3.5, 0.15, 3.5); brim.Position = head.Position + Vector3.new(0, 1.1, 0)
    brim.Color = Color3.fromRGB(255, 180, 220); brim.Transparency = 0.5; brim.Material = Enum.Material.Glass
    brim.Anchored = false; brim.CanCollide = false; brim.Parent = HatModel
    
    -- Welds (FIRST PERSON FIX: use CFrame offset from head)
    local weld1 = Instance.new("Weld") weld1.Part0 = head; weld1.Part1 = cone
    weld1.C0 = CFrame.new(0, 1.8, 0) * CFrame.Angles(0, 0, 0); weld1.Parent = cone
    
    local weld2 = Instance.new("Weld") weld2.Part0 = cone; weld2.Part1 = ball
    weld2.C0 = CFrame.new(0, 1.1, 0); weld2.Parent = ball
    
    local weld3 = Instance.new("Weld") weld3.Part0 = cone; weld3.Part1 = brim
    weld3.C0 = CFrame.new(0, -0.9, 0); weld3.Parent = brim
end

local function RemoveHat() if HatModel then HatModel:Destroy(); HatModel = nil end end

-- Pink Trail (separate from ESP)
local TrailParticles = {}
local MAX_TRAIL = 15

local function SpawnTrailParticle()
    local char = Player.Character; if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end
    
    local p = Instance.new("Part") p.Name = "TrailPart"
    p.Size = Vector3.new(0.25, 0.25, 0.25); p.Shape = Enum.PartType.Ball
    p.Position = root.Position - Vector3.new(0, 2.5, 0)
    p.Color = Color3.fromRGB(255, 150, 200); p.Transparency = 0.5
    p.Material = Enum.Material.Neon; p.Anchored = true; p.CanCollide = false; p.Parent = workspace
    
    table.insert(TrailParticles, p)
    if #TrailParticles > MAX_TRAIL then local old = table.remove(TrailParticles, 1); if old then old:Destroy() end end
    
    task.delay(1.5, function()
        for i = 1, 8 do if not p.Parent then break end; p.Transparency = p.Transparency + 0.06; task.wait(0.04) end
        if p then p:Destroy() end; for i, v in ipairs(TrailParticles) do if v == p then table.remove(TrailParticles, i) break end end
    end)
end

local function SetHat(v) PlayerVisuals.Hat = v; if v then CreateHat() else RemoveHat() end end
