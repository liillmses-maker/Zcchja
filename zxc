            b.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then MobileFlyState[k] = true end end)
            b.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then MobileFlyState[k] = false end end)
            return b
        end
        local cx, cy, o = 0.5, 0.6, 60
        CB("Fwd", UDim2.new(cx, -25, cy, -25 - o), "▲", "forward")
        CB("Bwd", UDim2.new(cx, -25, cy, -25 + o), "▼", "backward")
        CB("Left", UDim2.new(cx, -25 - o, cy, -25), "◄", "left")
        CB("Right", UDim2.new(cx, -25 + o, cy, -25), "►", "right")
        CB("Up", UDim2.new(0.8, -25, cy, -25 - o), "⇧", "up")
        CB("Down", UDim2.new(0.8, -25, cy, -25 + o), "⇩", "down")
        local sb = Instance.new("TextButton") sb.Size = UDim2.fromOffset(80, 35); sb.Position = UDim2.new(0.5, -40, 0.85, 0); sb.Text = "SPRINT"; sb.BackgroundColor3 = Color3.fromRGB(255, 100, 150); sb.BackgroundTransparency = bt; sb.TextColor3 = Color3.fromRGB(255,255,255); sb.Font = Enum.Font.GothamBold; sb.TextSize = 14; sb.BorderSizePixel = 0; sb.Parent = MobileGui; Instance.new("UICorner", sb).CornerRadius = UDim.new(0, 12)
        sb.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then MobileFlyState.sprint = true end end)
        sb.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then MobileFlyState.sprint = false end end)
    end
end

local function SetFly(v)
    local char = Player.Character; if not char then return end; local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end; local hum = char:FindFirstChildOfClass("Humanoid")
    if v then
        if hum then hum.PlatformStand = true; hum.AutoRotate = false end
        FlyBody = Instance.new("BodyVelocity") FlyBody.Velocity = Vector3.zero; FlyBody.MaxForce = Vector3.new(400000,400000,400000); FlyBody.P = 5000; FlyBody.Parent = root
        FlyGyro = Instance.new("BodyGyro") FlyGyro.MaxTorque = Vector3.new(400000,400000,400000); FlyGyro.P = 3000; FlyGyro.D = 100; FlyGyro.Parent = root
        if IsMobile then CreateMobileFlyButtons() end
        FlyConnection = RunService.RenderStepped:Connect(function()
            if not PM.Fly then return end; if not char or not char.Parent then return end; if not root or not root.Parent then return end
            local md = Vector3.zero
            if not IsMobile then
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then md += Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then md -= Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then md -= Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then md += Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then md += Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then md -= Vector3.new(0,1,0) end
            else
                if MobileFlyState.forward then md += Camera.CFrame.LookVector end
                if MobileFlyState.backward then md -= Camera.CFrame.LookVector end
                if MobileFlyState.left then md -= Camera.CFrame.RightVector end
                if MobileFlyState.right then md += Camera.CFrame.RightVector end
                if MobileFlyState.up then md += Vector3.new(0,1,0) end
                if MobileFlyState.down then md -= Vector3.new(0,1,0) end
            end
            if md.Magnitude > 0 then md = md.Unit end
            local s = 50 * FLY_SPEED
            if not IsMobile then if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then s = s * 2 end
            else if MobileFlyState.sprint then s = s * 2 end end
            if FlyBody then FlyBody.Velocity = md * s end
            if FlyGyro then FlyGyro.CFrame = Camera.CFrame end
        end)
    else
        if FlyBody then FlyBody:Destroy(); FlyBody = nil end; if FlyGyro then FlyGyro:Destroy(); FlyGyro = nil end
        if FlyConnection then FlyConnection:Disconnect(); FlyConnection = nil end
        if hum then hum.PlatformStand = false; hum.AutoRotate = true end
        if MobileGui then MobileGui:Destroy(); MobileGui = nil end
        for k in pairs(MobileFlyState) do MobileFlyState[k] = false end
    end
end

