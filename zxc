-- ================== UTILS ==================
local function getRoot()
    local char = Player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end
    return nil
end

local function classify(obj)
    if obj:IsA("Sound") then return "AUDIO" end
    if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") then return "VISUAL" end
    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then return "INTRUDER" end
    return "OBJECT"
end

local function getRoom(pos)
    if not pos then return "?" end
    if pos.Y < 0 then return "Basement" end
    if pos.Y > 8 then return "Upstairs" end
    if pos.X < -30 then return "Study/Garage" end
    if pos.X > 30 then return "Kitchen/Nursery" end
    if pos.Z < -30 then return "Hallway" end
    if pos.Z > 30 then return "Living/Bedroom" end
    return "?"
end

-- ================== ENTITY REGISTER ==================
local function register(obj)
    if ECS.entities[obj] then return end
    local part = getPart(obj)
    if not part then return end
    
    ECS.entities[obj] = true
    ECS.components.Transform[obj] = {pos = part.Position, size = part.Size}
    ECS.components.Meta[obj] = {type = classify(obj), room = getRoom(part.Position)}
    
    if obj:IsA("BasePart") then
        ECS.components.Visual[obj] = {color = part.Color, material = part.Material}
        part:GetPropertyChangedSignal("Color"):Connect(function()
            EventBus:Emit("VisualChanged", obj, "color", part.Color)
        end)
    end
    
    if obj:IsA("Sound") then
        ECS.components.Audio[obj] = {id = obj.SoundId, playing = obj.IsPlaying}
        obj:GetPropertyChangedSignal("SoundId"):Connect(function()
            EventBus:Emit("AudioChanged", obj, "soundId")
        end)
        obj:GetPropertyChangedSignal("IsPlaying"):Connect(function()
            EventBus:Emit("AudioChanged", obj, obj.IsPlaying and "start" or "stop")
        end)
    end
    
    EventBus:Emit("EntityAdded", obj, ECS.components.Meta[obj].type)
end

local function unregister(obj)
    if not ECS.entities[obj] then return end
    ECS.entities[obj] = nil
    ECS.components.Transform[obj] = nil
    ECS.components.Visual[obj] = nil
    ECS.components.Audio[obj] = nil
    ECS.components.Meta[obj] = nil
    EventBus:Emit("EntityRemoved", obj)
end

