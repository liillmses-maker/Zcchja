local Detected = {}
local CirclePool = {}
local LastScan = 0
local SCAN_INT = IsMobile and 0.6 or 0.35
local AnimTime = 0

local function GetPart(obj)
    if obj:IsA("BasePart") then return obj end
    return obj:FindFirstChildOfClass("BasePart") or obj.PrimaryPart
end

local function MatchName(name, list)
    local lower = name:lower()
    for _, kw in ipairs(list) do
        if lower:find(kw:lower()) then return true end
    end
    return false
end

local function GetBoundingRadius(part)
    local size = part.Size
    return math.clamp(math.max(size.X, size.Y, size.Z) * 0.75, 3, 35)
end

local function GetCircle()
    for _, c in ipairs(CirclePool) do
        if not c.Visible then return c end
    end
    local c = Drawing.new("Circle")
    c.Thickness = 1.5
    c.Filled = false
    c.Transparency = 1
    c.NumSides = 36
    table.insert(CirclePool, c)
    return c
end

local ObjectStates = {}

local function GetObjectHash(obj)
    local part = GetPart(obj)
    if not part then return "" end
    return obj.Name .. tostring(part.Position) .. tostring(part.Size)
end

local function HasChanged(obj)
    local hash = GetObjectHash(obj)
    if hash == "" then return false end
    if ObjectStates[obj] and ObjectStates[obj] ~= hash then
        ObjectStates[obj] = hash
        return true
    end
    ObjectStates[obj] = hash
    return false
end

RunService.RenderStepped:Connect(function(dt)
    AnimTime += dt
    LastScan += dt
    
    if LastScan >= SCAN_INT then
        LastScan = 0
        
        local dead = {}
        for obj, data in pairs(Detected) do
            if not obj or not obj.Parent then
                table.insert(dead, obj)
                if data.circle then data.circle.Visible = false end
                ObjectStates[obj] = nil
            end
        end
        for _, obj in ipairs(dead) do Detected[obj] = nil end
        
        local anyESP = Settings.ShowAnomalyESP or Settings.ShowObjectESP or Settings.ShowChangesESP
        
        if anyESP then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if Detected[obj] then
                    if Settings.ShowChangesESP and HasChanged(obj) then
                        Detected[obj].color = C.CHANGE_YELLOW
                        Detected[obj].radius = GetBoundingRadius(GetPart(obj))
                        SendNotification("=o_o= changed", obj.Name, "=*.*=")
                    end
                    continue
                end
                if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
                
                local isAnomaly = false
                local color = C.OBJECT_PINK
                local notifIcon = "=^.^="
                
                if Settings.ShowAnomalyESP and MatchName(obj.Name, ANOMALY_KEYWORDS) then
                    isAnomaly = true
                    color = C.ANOMALY_RED
                    notifIcon = "=o_o="
                elseif Settings.ShowObjectESP and MatchName(obj.Name, OBJECT_KEYWORDS) then
                    isAnomaly = true
                    color = C.OBJECT_PINK
                    notifIcon = "=^.^="
                elseif Settings.ShowChangesESP then
                    local part = GetPart(obj)
                    if part and part:IsA("BasePart") then
                        if part.Velocity.Magnitude > 0.1 or part.RotVelocity.Magnitude > 0.1 then
                            isAnomaly = true
                            color = C.CHANGE_YELLOW
                            notifIcon = "=*.*="
                        end
                    end
                end
                
                if isAnomaly then
                    local part = GetPart(obj)
                    if part then
                        local radius = GetBoundingRadius(part)
                        Detected[obj] = {
                            part = part,
                            color = color,
                            radius = radius,
                            circle = nil
                        }
                        ObjectStates[obj] = GetObjectHash(obj)
                        SendNotification("=^^= detected", obj.Name, notifIcon)
                    end
                end
            end
        end
    end
    
    local count = 0
    for _ in pairs(Detected) do count += 1 end
    local anyOn = Settings.ShowAnomalyESP or Settings.ShowObjectESP or Settings.ShowChangesESP
    StatusLabel.Text = anyOn and ("=^^= " .. count) or "=^.^= idle"
    StatusLabel.TextColor3 = anyOn and C.PINK_LIGHT or C.GRAY
    
    for _, c in ipairs(CirclePool) do c.Visible = false end
    
    local ci = 1
    for obj, data in pairs(Detected) do
        local part = data.part
        if part and part.Parent then
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                if not data.circle then data.circle = GetCircle() end
                local circle = data.circle
                circle.Position = Vector2.new(pos.X, pos.Y)
                circle.Radius = data.radius * (1 + math.sin(AnimTime * 1.8 + obj:GetHash() * 0.01) * 0.06)
                circle.Color = data.color
                circle.Thickness = 1.5 + math.sin(AnimTime * 2.5) * 0.25
                circle.Visible = true
                ci += 1
            end
        end
    end
end)

