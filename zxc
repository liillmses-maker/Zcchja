-- ================== ESP ==================
local Detected = {}
local LinePool = {}
local LastScan = 0
local Interval = IsMobile and 0.4 or 0.2
local AnimTime = 0

function GetPart(o)
    if o:IsA("BasePart") then return o end
    return o:FindFirstChildOfClass("BasePart") or o.PrimaryPart
end

function GetLine()
    for _, l in ipairs(LinePool) do if not l.Visible then return l end end
    local l = Drawing.new("Line"); l.Thickness = 2; l.Transparency = 1
    table.insert(LinePool, l); return l
end

local function GetCorners(part)
    local cf, s = part.CFrame, part.Size / 2
    return {cf * Vector3.new(-s.X, -s.Y, -s.Z), cf * Vector3.new(s.X, -s.Y, -s.Z),
        cf * Vector3.new(s.X, -s.Y, s.Z), cf * Vector3.new(-s.X, -s.Y, s.Z),
        cf * Vector3.new(-s.X, s.Y, -s.Z), cf * Vector3.new(s.X, s.Y, -s.Z),
        cf * Vector3.new(s.X, s.Y, s.Z), cf * Vector3.new(-s.X, s.Y, s.Z)}
end

local function DrawWireframe(part, color)
    local corners = GetCorners(part)
    local edges = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
    for _, e in ipairs(edges) do
        local p1, p2 = Camera:WorldToViewportPoint(corners[e[1]]), Camera:WorldToViewportPoint(corners[e[2]])
        if p1.Z > 0 and p2.Z > 0 then
            local l = GetLine(); l.From = Vector2.new(p1.X, p1.Y); l.To = Vector2.new(p2.X, p2.Y)
            l.Color = color; l.Visible = true
        end
    end
end

local function IsAnomaly(name)
    local list = {"Alternate", "HallwayIntruder", "Devil", "Mask", "Dummy", "Mannequin", "BloodPart", "N", "aliveei_loli", "Intruder", "Monster", "Creature", "Entity", "Pentagram", "Eyes", "Jumpscares"}
    for _, k in ipairs(list) do if name:find(k) then return true end end
    return false
end

local function IsObject(name)
    local list = {"AnnoyingOrange", "Orange", "Float Duck", "Duck", "Crib", "Rockingmachine", "Soap", "Mirror", "Sink", "Curtain", "TV", "Telephone", "Alarm Clock", "Whiteboard", "Papers", "Paper", "Books", "Poster", "Painting", "MonaLisa", "Frame", "Monitor", "Keyboard", "Mouse", "Carpet", "Chair", "Table", "Desk", "Shelf", "Shoes", "Closet", "Door", "Window", "Fridge", "Oven", "Frying Pan", "Cup", "CoffeeJar", "Container", "Cola", "Trash Can", "Box", "Cardboard", "Tire", "Plant", "Vase", "Light", "Lamp", "Neon", "Figurine", "Bed", "Pillow", "Glass", "Bleach", "Fence", "Car", "Pipe", "crayon", "pic1", "pic2", "pic3"}
    for _, k in ipairs(list) do if name:find(k) then return true end end
    return false
end

RunService.RenderStepped:Connect(function(dt)
    AnimTime = AnimTime + dt; LastScan = LastScan + dt
    
    if LastScan >= Interval then
        LastScan = 0
        local dead = {}
        for o in pairs(Detected) do if not o or not o.Parent then table.insert(dead, o) end end
        for _, o in ipairs(dead) do Detected[o] = nil end
        
        if MasterOn and (Settings.AnomalyESP or Settings.ObjectESP or Settings.ChangesESP) then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if Detected[obj] then continue end
                if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
                
                local ok = false; local col = C.PINK_ESP
                if Settings.AnomalyESP and IsAnomaly(obj.Name) then ok = true; col = C.RED
                elseif Settings.ObjectESP and IsObject(obj.Name) then ok = true; col = C.PINK_ESP
                elseif Settings.ChangesESP then
                    local p = GetPart(obj)
                    if p and p:IsA("BasePart") and (p.Velocity.Magnitude > 0.1 or p.RotVelocity.Magnitude > 0.1) then ok = true; col = C.YELLOW end
                end
                if ok then Detected[obj] = {col = col} end
            end
        end
    end
    
    local n = 0; for _ in pairs(Detected) do n = n + 1 end
    Status.Text = MasterOn and ("=^^= " .. n .. " detected") or "=.= off"
    Status.TextColor3 = MasterOn and C.PINK or C.GRAY
    
    for _, l in ipairs(LinePool) do l.Visible = false end
    if not MasterOn then return end
    
    for obj, data in pairs(Detected) do
        if obj and obj.Parent then
            if obj:IsA("Model") then
                for _, child in ipairs(obj:GetDescendants()) do
                    if child:IsA("BasePart") then DrawWireframe(child, data.col) end
                end
            elseif obj:IsA("BasePart") then
                DrawWireframe(obj, data.col)
            end
        end
    end
end)

