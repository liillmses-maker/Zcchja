        AnimTime = AnimTime + dt
        
        if MasterOn and (Settings.ShowAnomaly or Settings.ShowObject or Settings.ShowChanges) then
            for _, c in ipairs(Circles) do c.Visible = false end
            
            for obj, data in pairs(Detected) do
                if obj and obj.Parent then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart") or obj.PrimaryPart
                    if part then
                        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local cr = GetCircle()
                            if cr then
                                local seed = string.byte(obj.Name, 1) or 1
                                cr.Position = Vector2.new(pos.X, pos.Y)
                                cr.Radius = data.r * (1 + math.sin(AnimTime * 2 + seed) * 0.04)
                                cr.Color = data.col
                                cr.Visible = true
                            end
                        end
                    end
                end
            end
        else
            for _, c in ipairs(Circles) do c.Visible = false end
        end
        
        local monsterCount = 0
        local objectCount = 0
        for _, data in pairs(Detected) do
            if data.etype == "MONSTER" then monsterCount = monsterCount + 1
            else objectCount = objectCount + 1 end
        end
        
        StatusText.Text = MasterOn and ("R:" .. monsterCount .. " P:" .. objectCount) or "=;= Idle"
        StatusText.TextColor3 = MasterOn and C.PINK or C.GRAY
    end)
    
    -- Scanner for Skin/Size detect
    spawn(function()
        local ODB = {}
        while Main and Main.Parent do
            wait(0.5)
            if MasterOn and Settings.Scanner then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        local st = {s = obj.Size, c = obj.Color, m = obj.Material}
                        if ODB[obj] then
                            if Settings.SkinDetect and (ODB[obj].c ~= st.c or ODB[obj].m ~= st.m) then
                                local room = GetRoomName(obj.Position)
                                AddLog("[SKIN] [" .. room .. "] " .. obj.Name .. " changed", C.PINK)
                            end
                            if Settings.SizeDetect and (ODB[obj].s - st.s).Magnitude > 0.1 then
                                local room = GetRoomName(obj.Position)
                                AddLog("[SIZE] [" .. room .. "] " .. obj.Name .. " resized", C.PINK)
                            end
                        end
                        ODB[obj] = st
                    end
                end
            end
        end
    end)
end

