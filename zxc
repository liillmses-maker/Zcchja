local MobileFlyState = {forward = false, backward = false, left = false, right = false, up = false, down = false, sprint = false}
local MobileGui

local function CreateMobileFlyButtons()
    if IsMobile then
        MobileGui = Instance.new("ScreenGui") MobileGui.Name = "MobileFly"; MobileGui.Parent = PLAYERGUI; MobileGui.ResetOnSpawn = false
