RunService.RenderStepped:Connect(function(dt)
    AnimTime += dt; LastScan += dt
    
    if LastScan >= Interval then
        LastScan = 0
        
        local dead = {}
        for o in pairs(Detected) do if not o or not o.Parent then table.insert(dead, o) end end
        for _, o in ipairs(dead) do Detected[o] = nil end
        
        for _, c in ipairs(DebugList:GetChildren()) do if c:IsA("TextLabel") then c:Remove() end end
        AllNearbyNames = {}
        
        local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        
        if MasterOn then
            for _, o in ipairs(workspace:GetDescendants()) do
                if not (o:IsA("Model") or o:IsA("BasePart")) then continue end
                local p = GetPart(o)
                if not p then continue end
                
                local dist = root and (p.Position - root.Position).Magnitude or 0
                
                if dist < 80 and not AllNearbyNames[o.Name] then
                    AllNearbyNames[o.Name] = {dist = dist, obj = o}
                end
                
                if dist < 50 and not Detected[o] then
                    Detected[o] = {p = p, col = Color3.fromRGB(255, 255, 255)}
                end
            end
            
            -- Sort and show
            local sorted = {}
            for name, data in pairs(AllNearbyNames) do table.insert(sorted, {name = name, dist = data.dist}) end
            table.sort(sorted, function(a, b) return a.dist < b.dist end)
            
            for _, entry in ipairs(sorted) do
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, -4, 0, 12)
                lbl.Text = " " .. entry.name .. " [" .. math.floor(entry.dist) .. "m]"
                lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
                lbl.Font = Enum.Font.Gotham; lbl.TextSize = 8
                lbl.BackgroundTransparency = 1; lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Parent = DebugList
            end
            DebugList.CanvasSize = UDim2.new(0, 0, 0, DebugLayout.AbsoluteContentSize.Y + 2)
        end
        
        -- Auto copy every 10 seconds
        LastCopyTime += Interval
        if LastCopyTime >= 10 and setclipboard then
            LastCopyTime = 0
            local names = {}
            for name in pairs(AllNearbyNames) do table.insert(names, name) end
            table.sort(names)
            local text = table.concat(names, "\n")
            setclipboard(text)
        end
    end
    
    local n = 0; for _ in pairs(Detected) do n = n + 1 end
    StatusLabel.Text = "=^^= " .. n .. " objects"
    
    for _, l in ipairs(LinePool) do l.Visible = false end
    if not MasterOn then return end
    
    for o, d in pairs(Detected) do
        local p = d.p
        if p and p.Parent then
            if o:IsA("Model") then
                for _, c in ipairs(o:GetDescendants()) do
                    if c:IsA("BasePart") then DrawWireframe(c, d.col, o:GetHash()) end
                end
            else
                DrawWireframe(p, d.col, o:GetHash())
            end
        end
    end
end)

