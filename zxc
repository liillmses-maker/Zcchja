local function CreatePawToggle(parent, name, default, callback)
    local enabled = default
    
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, 0, 0, 34)
    Row.BackgroundColor3 = C.BG2
    Row.BorderSizePixel = 0
    Row.Parent = parent
    Instance.new("UICorner",Row).CornerRadius = UDim.new(0,14)
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.5, 0, 1, 0)
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.Text = name
    Label.TextColor3 = C.GRAY
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 10
    Label.BackgroundTransparency = 1
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Row
    
    local PawBtn = Instance.new("TextButton")
    PawBtn.Size = UDim2.new(0, 44, 0, 44)
    PawBtn.Position = UDim2.new(1, -50, 0.5, -22)
    PawBtn.Text = "=;="
    PawBtn.BackgroundColor3 = C.OFF
    PawBtn.TextColor3 = C.GRAY
    PawBtn.Font = Enum.Font.GothamBold
    PawBtn.TextSize = 11
    PawBtn.BorderSizePixel = 0
    PawBtn.Parent = Row
    Instance.new("UICorner",PawBtn).CornerRadius = UDim.new(1,0)
    
    -- Glow effect
    local GlowEffect = Instance.new("Frame")
    GlowEffect.Size = UDim2.new(1, 6, 1, 6)
    GlowEffect.Position = UDim2.new(0, -3, 0, -3)
    GlowEffect.BackgroundColor3 = C.ACCENT
    GlowEffect.BackgroundTransparency = 1
    GlowEffect.BorderSizePixel = 0
    GlowEffect.ZIndex = 0
    GlowEffect.Parent = PawBtn
    Instance.new("UICorner",GlowEffect).CornerRadius = UDim.new(1,0)
    
    local function SetState(state)
        enabled = state
        if state then
            PawBtn.Text = "=^^="
            TweenService:Create(PawBtn, TweenInfo.new(0.25, Enum.EasingStyle.Back), {
                Size = UDim2.new(0, 48, 0, 48),
                Position = UDim2.new(1, -52, 0.5, -24),
                BackgroundColor3 = C.ON,
                TextColor3 = C.WHITE
            }):Play()
            TweenService:Create(GlowEffect, TweenInfo.new(0.3), {BackgroundTransparency = 0.6}):Play()
            Label.TextColor3 = C.WHITE
        else
            PawBtn.Text = "=;="
            TweenService:Create(PawBtn, TweenInfo.new(0.2), {
                Size = UDim2.new(0, 44, 0, 44),
                Position = UDim2.new(1, -50, 0.5, -22),
                BackgroundColor3 = C.OFF,
                TextColor3 = C.GRAY
            }):Play()
            TweenService:Create(GlowEffect, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
            Label.TextColor3 = C.GRAY
        end
    end
    
    PawBtn.MouseButton1Click:Connect(function()
        SetState(not enabled)
        callback(not enabled)
    end)
    
    SetState(default)
    return Row
end

