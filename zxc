-- ================== SCANNER ==================
local ObjectDB = {}
local LastScan = 0
local LastCopy = 0
local LastSoundCheck = 0
local LastClockCheck = 0
local LastFaceCheck = 0
local CopiedChanges = {}
local ClockSpeed = 1
local PrevClockTime = Lighting.ClockTime

local function GetObjectState(obj)
    if obj:IsA("BasePart") then
        return {
            pos = obj.Position, rot = obj.Orientation, size = obj.Size,
            color = obj.Color, transparency = obj.Transparency,
            material = obj.Material, anchored = obj.Anchored
        }
    elseif obj:IsA("Model") then
        local part = obj:FindFirstChildOfClass("BasePart") or obj.PrimaryPart
        if part then return {pos = part.Position, rot = part.Orientation, size = part.Size} end
    end
    return nil
end

local function HasStateChanged(old, new)
    if not old or not new then return true end
    if old.pos and new.pos and (old.pos - new.pos).Magnitude > 0.1 then return true end
    if old.rot and new.rot and (old.rot - new.rot).Magnitude > 0.5 then return true end
    if old.size and new.size and (old.size - new.size).Magnitude > 0.1 then return true end
    if old.color and new.color and old.color ~= new.color then return true end
    if old.transparency and new.transparency and math.abs(old.transparency - new.transparency) > 0.01 then return true end
    if old.material and new.material and old.material ~= new.material then return true end
    if old.anchored ~= nil and new.anchored ~= nil and old.anchored ~= new.anchored then return true end
    return false
end

local function GetChangeType(old, new)
    local changes = {}
    if old.pos and new.pos and (old.pos - new.pos).Magnitude > 0.1 then table.insert(changes, "MOVED") end
    if old.rot and new.rot and (old.rot - new.rot).Magnitude > 0.5 then table.insert(changes, "ROTATED") end
    if old.size and new.size and (old.size - new.size).Magnitude > 0.1 then table.insert(changes, "RESIZED") end
    if old.color and new.color and old.color ~= new.color then table.insert(changes, "COLOR_CHANGE") end
    if old.material and new.material and old.material ~= new.material then table.insert(changes, "MATERIAL_CHANGE") end
    return table.concat(changes, "+")
end

RunService.RenderStepped:Connect(function(dt)
    LastScan = LastScan + dt
    LastCopy = LastCopy + dt
    LastSoundCheck = LastSoundCheck + dt
    LastClockCheck = LastClockCheck + dt
    LastFaceCheck = LastFaceCheck + dt
    
    -- ================== SOUND DETECTOR ==================
    if Settings.DetectSounds and LastSoundCheck >= 1 then
        LastSoundCheck = 0
        local sounds = workspace:GetDescendants()
        for _, obj in ipairs(sounds) do
            if obj:IsA("Sound") and obj.IsPlaying and obj.Volume > 0.1 then
                if not obj:GetAttribute("Reported") then
                    obj:SetAttribute("Reported", true)
                    local room = GetRoomName(obj)
                    local msg = "[SOUND] [" .. room .. "] " .. obj.Name .. " | " .. (obj.SoundId or "unknown")
                    table.insert(CopiedChanges, msg)
                    AddLog(msg, C.CYAN)
                    Notify("SOUND", msg, 3)
                end
            end
        end
    end
    
    -- ================== CLOCK DETECTOR ==================
    if Settings.DetectClock and LastClockCheck >= 0.5 then
        LastClockCheck = 0
        local currentTime = Lighting.ClockTime
        local timeDiff = math.abs(currentTime - PrevClockTime)
        if timeDiff > 0.05 then
            local speed = timeDiff / 0.5
            if speed > 2 then
                local msg = "[CLOCK] Time accelerated x" .. math.floor(speed)
                table.insert(CopiedChanges, msg)
                AddLog(msg, Color3.fromRGB(255, 150, 50))
                Notify("CLOCK", msg, 2)
            end
        end
        PrevClockTime = currentTime
    end
    
    -- ================== FACE DETECTOR (ORANGE + OBJECTS) ==================
    if Settings.DetectFaces and LastFaceCheck >= 0.5 then
        LastFaceCheck = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local name = obj.Name:lower()
                -- Check for AnnoyingOrange or any orange with face
                if name:find("annoying") or name:find("orange") then
                    -- Check if it has a Decal/Texture (face)
                    for _, child in ipairs(obj:GetDescendants()) do
                        if child:IsA("Decal") or child:IsA("Texture") then
                            if not obj:GetAttribute("FaceReported") then
                                obj:SetAttribute("FaceReported", true)
                                local room = GetRoomName(obj)
                                local msg = "[FACE] [" .. room .. "] " .. obj.Name .. " has a FACE!"
                                table.insert(CopiedChanges, msg)
                                AddLog(msg, Color3.fromRGB(255, 100, 255))
                                Notify("FACE", msg, 3)
                            end
                        end
                    end
                end
                -- Check for face on paintings/walls
                if name:find("painting") or name:find("portrait") or name:find("mona") then
                    for _, child in ipairs(obj:GetDescendants()) do
                        if child:IsA("Decal") or child:IsA("Texture") then
                            local texture = child:IsA("Texture") and child.Texture or ""
                            if texture ~= "" and not obj:GetAttribute("FaceReported") then
                                obj:SetAttribute("FaceReported", true)
                                local room = GetRoomName(obj)
                                local msg = "[FACE] [" .. room .. "] " .. obj.Name .. " texture changed!"
                                table.insert(CopiedChanges, msg)
                                AddLog(msg, Color3.fromRGB(255, 100, 255))
                                Notify("FACE", msg, 3)
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- ================== OBJECT SCANNER ==================
    if LastScan >= 0.5 then
        LastScan = 0
        
        local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        local currentObjects = {}
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
            if obj:IsA("BasePart") and obj.Transparency > 0.95 then continue end
            if obj.Name == "Terrain" then continue end
            
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
            if not part then continue end
            
            local dist = (part.Position - root.Position).Magnitude
            if dist > Settings.ScanRange then continue end
            
            local state = GetObjectState(obj)
            if not state then continue end
            
            currentObjects[obj] = state
            
            if ObjectDB[obj] then
                if HasStateChanged(ObjectDB[obj], state) then
                    local room = GetRoomName(obj)
                    local changeType = GetChangeType(ObjectDB[obj], state)
                    local msg = "[CHANGE] [" .. room .. "] " .. obj.Name .. ": " .. changeType
                    table.insert(CopiedChanges, msg)
                    AddLog(msg, C.YELLOW)
                    Notify("CHANGE", msg, 2)
                end
            else
                if not obj:GetAttribute("NewReported") then
                    obj:SetAttribute("NewReported", true)
                    local room = GetRoomName(obj)
                    local msg = "[NEW] [" .. room .. "] " .. obj.Name
                    table.insert(CopiedChanges, msg)
                    AddLog(msg, C.GREEN)
                end
            end
        end
        
        -- Check removed
        for obj, oldState in pairs(ObjectDB) do
            if not currentObjects[obj] then
                local room = GetRoomName(obj)
                local msg = "[REMOVED] [" .. room .. "] " .. obj.Name
                table.insert(CopiedChanges, msg)
                AddLog(msg, C.RED)
                Notify("REMOVED", msg, 2)
            end
        end
        
        ObjectDB = currentObjects
        
        -- Auto copy
        if Settings.AutoCopy and #CopiedChanges > 0 and LastCopy >= 5 and setclipboard then
            LastCopy = 0
            local unique = {}
            for _, v in ipairs(CopiedChanges) do unique[v] = true end
            local text = ""
            for k in pairs(unique) do text = text .. k .. "\n" end
            setclipboard(text)
            CopiedChanges = {}
            Status.Text = "~ copied!"
            Status.TextColor3 = C.GREEN
            spawn(function() wait(2) Status.TextColor3 = C.GRAY end)
        end
        
        local total = 0; for _ in pairs(ObjectDB) do total = total + 1 end
        Status.Text = "~ " .. total .. " obj | " .. Settings.ScanRange .. "m"
    end
end)

