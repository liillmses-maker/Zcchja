local function GetFullState(obj)
    if not obj or not obj.Parent then return nil end
    local s={name=obj.Name,class=obj.ClassName}
    if obj:IsA("BasePart")then
        s.pos=obj.Position;s.size=obj.Size;s.color=obj.Color;s.material=obj.Material;s.transparency=obj.Transparency
        local vel=obj.AssemblyLinearVelocity or obj.Velocity;s.velocity=vel or Vector3.zero
        s.rotvelocity=obj.RotVelocity or Vector3.zero
    elseif obj:IsA("Model")then
        local pp=obj:FindFirstChildOfClass("BasePart")or obj.PrimaryPart
        if pp then s.pos=pp.Position;s.size=pp.Size end
        s.humanoid=obj:FindFirstChildOfClass("Humanoid")~=nil
    end
    local textures={}
    for _,child in ipairs(obj:GetDescendants())do
        if child:IsA("Decal")then textures[#textures+1]=child.Texture
        elseif child:IsA("Texture")then textures[#textures+1]=child.Texture
        elseif child:IsA("ImageLabel")then textures[#textures+1]=child.Image end
    end
    s.textures=textures
    local sounds={}
    for _,child in ipairs(obj:GetDescendants())do
        if child:IsA("Sound")then sounds[#sounds+1]={id=child.SoundId,playing=child.IsPlaying,volume=child.Volume}end
    end
    s.sounds=sounds
    local count=0;for _ in ipairs(obj:GetChildren())do count=count+1 end
    s.childCount=count
    return s
end

local function CompareStates(old,new)
    if not old or not new then return{"APPEARED"}end
    local changes={}
    if old.pos and new.pos then local diff=(old.pos-new.pos);if math.abs(diff.X)>0.1 or math.abs(diff.Y)>0.1 or math.abs(diff.Z)>0.1 then changes[#changes+1]="MOVED" end end
    if old.size and new.size then local diff=(old.size-new.size);if math.abs(diff.X)>0.1 or math.abs(diff.Y)>0.1 or math.abs(diff.Z)>0.1 then changes[#changes+1]="SIZE" end end
    if old.color and new.color and old.color~=new.color then changes[#changes+1]="COLOR" end
    if old.material and new.material and old.material~=new.material then changes[#changes+1]="MATERIAL" end
    if old.transparency and new.transparency and math.abs(old.transparency-new.transparency)>0.01 then changes[#changes+1]="ALPHA" end
    if old.velocity and old.velocity.Magnitude>0.3 then changes[#changes+1]="MOVING" end
    if old.childCount and new.childCount and old.childCount~=new.childCount then changes[#changes+1]="CHILDREN" end
    if old.textures and new.textures then if#old.textures~=#new.textures then changes[#changes+1]="TEXTURE"else for i=1,#old.textures do if old.textures[i]~=new.textures[i]then changes[#changes+1]="TEXTURE";break end end end end
    if old.sounds and new.sounds then if#old.sounds~=#new.sounds then changes[#changes+1]="SOUND"else for i=1,#old.sounds do if old.sounds[i].id~=new.sounds[i].id or old.sounds[i].playing~=new.sounds[i].playing then changes[#changes+1]="SOUND";break end end end end
    return#changes>0 and changes or nil
end

