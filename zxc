-- ================== ESP + DEBUG + AUTO COPY ==================
local Detected = {}
local LinePool = {}
local LastScan, Interval = 0, IsMobile and 0.5 or 0.3
local AnimTime = 0
local AllNearbyNames = {}
local LastCopyTime = 0

function GetPart(o)
    if o:IsA("BasePart") then return o end
    return o:FindFirstChildOfClass("BasePart") or o.PrimaryPart
end

function GetLine()
    for _, l in ipairs(LinePool) do if not l.Visible then return l end end
    local l = Drawing.new("Line"); l.Thickness = 2; l.Transparency = 1; table.insert(LinePool, l); return l
end

local function GetCorners(part)
    local cf, s = part.CFrame, part.Size / 2
    return {cf * Vector3.new(-s.X, -s.Y, -s.Z), cf * Vector3.new(s.X, -s.Y, -s.Z), cf * Vector3.new(s.X, -s.Y, s.Z), cf * Vector3.new(-s.X, -s.Y, s.Z), cf * Vector3.new(-s.X, s.Y, -s.Z), cf * Vector3.new(s.X, s.Y, -s.Z), cf * Vector3.new(s.X, s.Y, s.Z), cf * Vector3.new(-s.X, s.Y, s.Z)}
end

local function DrawWireframe(part, color, hash)
    local corners = GetCorners(part)
    local edges = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
    local pulse = 1 + math.sin(AnimTime * 2.5 + hash * 0.01) * 0.05
    for _, e in ipairs(edges) do
        local p1, p2 = Camera:WorldToViewportPoint(corners[e[1]]), Camera:WorldToViewportPoint(corners[e[2]])
        if p1.Z > 0 and p2.Z > 0 then
            local l = GetLine(); l.From = Vector2.new(p1.X, p1.Y); l.To = Vector2.new(p2.X, p2.Y)
            l.Color = color; l.Thickness = 2 * pulse; l.Visible = true
        end
    end
end

