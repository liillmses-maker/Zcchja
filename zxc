-- ================== NPC ESP ==================
local NPCs = {}
local function IsNPC(obj) if obj:IsA("Model") then if obj:FindFirstChildOfClass("Humanoid") then return true end; if obj:FindFirstChild("HumanoidRootPart") then return true end end; return false end
local function GetPart(obj) if obj:IsA("BasePart") then return obj end; if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end; return nil end

workspace.DescendantAdded:Connect(function(obj) if IsNPC(obj) and obj ~= Player.Character then NPCs[obj] = true end end)
workspace.DescendantRemoving:Connect(function(obj) NPCs[obj] = nil end)
task.defer(function() task.wait(1) for _, obj in ipairs(workspace:GetDescendants()) do if IsNPC(obj) and obj ~= Player.Character then NPCs[obj] = true end end end)

if Drawing then
    local Circles = {}; local Texts = {}
    function GetCircle() for _, c in ipairs(Circles) do if not c.Visible then return c end end; local c = Drawing.new("Circle") c.Thickness = 2; c.Filled = false; c.Transparency = 1; c.NumSides = 40; table.insert(Circles, c); return c end
    function GetText() for _, t in ipairs(Texts) do if not t.Visible then return t end end; local t = Drawing.new("Text") t.Size = 13; t.Center = true; t.Outline = true; t.OutlineColor = Color3.new(); table.insert(Texts, t); return t end
    RunService.RenderStepped:Connect(function()
        for _, c in ipairs(Circles) do c.Visible = false end; for _, t in ipairs(Texts) do t.Visible = false end
        local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart"); if not root then return end
        for obj in pairs(NPCs) do
            if not obj.Parent then NPCs[obj] = nil; continue end; local part = GetPart(obj); if not part then continue end
