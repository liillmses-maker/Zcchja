end
function GetText()
    for _,t in ipairs(TextLabels)do if not t.Visible then return t end end
    if Drawing then local t=Drawing.new("Text");t.Size=12;t.Center=true;t.Outline=true;t.OutlineColor=Color3.new();table.insert(TextLabels,t);return t end
