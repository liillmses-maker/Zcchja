    end
    
    local st=GetFullState(obj)
    if st then
        if not WorldState[obj]then
            local part=GetPart(obj);local room=part and GetRoom(part.Position)or"?"
            local root=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            local dist=root and math.floor((part.Position-root.Position).Magnitude)or 0
            ShowNotification("NEW ANOMALY",obj.Name.."\nRoom: "..room.." | Distance: "..dist.."m",C.GREEN)
        end
        MissingObjects[obj]=nil;WorldState[obj]=st
    end
end)

