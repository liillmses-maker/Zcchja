    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.Text = name
    Label.TextColor3 = C.GRAY
    Label.Font = Enum.Font.Gotham
    Label.TextSize = IsMobile and 10 or 11
    Label.BackgroundTransparency = 1
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Row
    
    local Tog = Instance.new("Frame")
    Tog.Size = UDim2.new(0, 38, 0, 20)
    Tog.Position = UDim2.new(1, -44, 0.5, -10)
    Tog.BackgroundColor3 = C.OFF
    Tog.BorderSizePixel = 0
    Tog.Parent = Row
    local TogCorner = Instance.new("UICorner")
    TogCorner.CornerRadius = UDim.new(1, 0)
    TogCorner.Parent = Tog
    
    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 16, 0, 16)
    Knob.Position = UDim2.new(0, 2, 0.5, -8)
    Knob.BackgroundColor3 = C.WHITE
    Knob.BorderSizePixel = 0
    Knob.Parent = Tog
    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob
    
    local Face = Instance.new("TextLabel")
    Face.Size = UDim2.new(1, 0, 1, 0)
    Face.Text = "=.="
    Face.TextColor3 = C.GRAY
    Face.Font = Enum.Font.GothamBold
    Face.TextSize = 6
    Face.BackgroundTransparency = 1
    Face.Parent = Knob
    
    local function SetState(state)
        enabled = state
        if state then
            TweenService:Create(Tog, TweenInfo.new(0.25), {BackgroundColor3 = C.ON}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.25), {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
            Face.Text = "=^^="
            Face.TextColor3 = C.ON
            Label.TextColor3 = C.WHITE
        else
            TweenService:Create(Tog, TweenInfo.new(0.25), {BackgroundColor3 = C.OFF}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.25), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
            Face.Text = "=.="
            Face.TextColor3 = C.GRAY
            Label.TextColor3 = C.GRAY
        end
    end
    
    Tog.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            SetState(not enabled)
            callback(not enabled)
        end
    end)
    
    SetState(default)
    return Row
end

