local Detected = {}
local LinePool = {}
local LastScan = 0
local Interval = IsMobile and 0.55 or 0.3
local Time = 0

function GetPart(o)
    if o:IsA("BasePart") then return o end
    return o:FindFirstChildOfClass("BasePart") or o.PrimaryPart
end

function Match(n, list)
    n = n:lower()
    for _, k in ipairs(list) do
        if n:find(k:lower()) then return true end
    end
    return false
end

function GetLine()
    for _, l in ipairs(LinePool) do
        if not l.Visible then return l end
    end
    local l = Drawing.new("Line")
    l.Thickness = 1.8
    l.Transparency = 1
    table.insert(LinePool, l)
    return l
end

-- Draw outline box using 4 lines
local function DrawOutline(pos2D, size2D, color, hash)
    local x = pos2D.X - size2D.X/2
    local y = pos2D.Y - size2D.Y/2
    local w = size2D.X
    local h = size2D.Y
    
    local pulse = 1 + math.sin(Time * 2 + hash * 0.01) * 0.04
    
    local top = GetLine()
    top.From = Vector2.new(x, y)
    top.To = Vector2.new(x + w, y)
    top.Color = color
    top.Thickness = 1.8 * pulse
    top.Visible = true
    
    local bottom = GetLine()
    bottom.From = Vector2.new(x, y + h)
    bottom.To = Vector2.new(x + w, y + h)
    bottom.Color = color
    bottom.Thickness = 1.8 * pulse
    bottom.Visible = true
    
    local left = GetLine()
    left.From = Vector2.new(x, y)
    left.To = Vector2.new(x, y + h)
    left.Color = color
    left.Thickness = 1.8 * pulse
    left.Visible = true
    
    local right = GetLine()
    right.From = Vector2.new(x + w, y)
    right.To = Vector2.new(x + w, y + h)
    right.Color = color
    right.Thickness = 1.8 * pulse
    right.Visible = true
    
    -- Corner accents (small extra lines for style)
    local cornerLen = math.min(w, h) * 0.2
    
    -- Top-left corner accent
    local tl1 = GetLine()
    tl1.From = Vector2.new(x - 2, y - 2)
    tl1.To = Vector2.new(x + cornerLen, y - 2)
    tl1.Color = color
    tl1.Thickness = 2.2 * pulse
    tl1.Visible = true
    
    local tl2 = GetLine()
    tl2.From = Vector2.new(x - 2, y - 2)
    tl2.To = Vector2.new(x - 2, y + cornerLen)
    tl2.Color = color
    tl2.Thickness = 2.2 * pulse
    tl2.Visible = true
    
    -- Top-right corner accent
    local tr1 = GetLine()
    tr1.From = Vector2.new(x + w - cornerLen, y - 2)
    tr1.To = Vector2.new(x + w + 2, y - 2)
    tr1.Color = color
    tr1.Thickness = 2.2 * pulse
    tr1.Visible = true
    
    local tr2 = GetLine()
    tr2.From = Vector2.new(x + w + 2, y - 2)
    tr2.To = Vector2.new(x + w + 2, y + cornerLen)
    tr2.Color = color
    tr2.Thickness = 2.2 * pulse
    tr2.Visible = true
    
    -- Bottom-left corner accent
    local bl1 = GetLine()
    bl1.From = Vector2.new(x - 2, y + h - cornerLen)
    bl1.To = Vector2.new(x - 2, y + h + 2)
    bl1.Color = color
    bl1.Thickness = 2.2 * pulse
    bl1.Visible = true
    
    local bl2 = GetLine()
    bl2.From = Vector2.new(x - 2, y + h + 2)
    bl2.To = Vector2.new(x + cornerLen, y + h + 2)
    bl2.Color = color
    bl2.Thickness = 2.2 * pulse
    bl2.Visible = true
    
    -- Bottom-right corner accent
    local br1 = GetLine()
    br1.From = Vector2.new(x + w - cornerLen, y + h + 2)
    br1.To = Vector2.new(x + w + 2, y + h + 2)
    br1.Color = color
    br1.Thickness = 2.2 * pulse
    br1.Visible = true
    
    local br2 = GetLine()
    br2.From = Vector2.new(x + w + 2, y + h - cornerLen)
    br2.To = Vector2.new(x + w + 2, y + h + 2)
    br2.Color = color
    br2.Thickness = 2.2 * pulse
    br2.Visible = true
end

RunService.RenderStepped:Connect(function(dt)
    Time = Time + dt
    LastScan = LastScan + dt
    
    if LastScan >= Interval then
        LastScan = 0
        
        local dead = {}
        for o, d in pairs(Detected) do
            if not o or not o.Parent then table.insert(dead, o) end
        end
        for _, o in ipairs(dead) do Detected[o] = nil end
        
        if MasterOn and (Settings.AnomalyESP or Settings.ObjectESP or Settings.ChangesESP) then
            for _, o in ipairs(workspace:GetDescendants()) do
                if Detected[o] then continue end
                if not (o:IsA("Model") or o:IsA("BasePart")) then continue end
                
                local ok = false
                local col = C.PINK_ESP
                
                if Settings.AnomalyESP and Match(o.Name, ANOMALY_WORDS) then
                    ok = true; col = C.RED
                elseif Settings.ObjectESP and Match(o.Name, OBJECT_WORDS) then
                    ok = true; col = C.PINK_ESP
                elseif Settings.ChangesESP then
                    local p = GetPart(o)
                    if p and p:IsA("BasePart") and (p.Velocity.Magnitude > 0.1 or p.RotVelocity.Magnitude > 0.1) then
                        ok = true; col = C.YELLOW
                    end
                end
                
                if ok then
                    local p = GetPart(o)
                    if p then Detected[o] = {p = p, col = col} end
                end
            end
        end
    end
    
    local n = 0
    for _ in pairs(Detected) do n = n + 1 end
    StatusLabel.Text = MasterOn and ("=^^= " .. n) or "=.= off"
    StatusLabel.TextColor3 = MasterOn and C.PINK or C.GRAY
    
    for _, l in ipairs(LinePool) do l.Visible = false end
    
    if not MasterOn then return end
    
    for o, d in pairs(Detected) do
        local p = d.p
        if p and p.Parent then
            local pos, on = Camera:WorldToViewportPoint(p.Position)
            if on then
                local s = Camera:WorldToViewportPoint(p.Position + p.Size)
                local w = math.abs(s.X - pos.X)
                local h = math.abs(s.Y - pos.Y)
                w = math.clamp(w * 1.15, 18, 180)
                h = math.clamp(h * 1.15, 18, 180)
                DrawOutline(pos, Vector2.new(w, h), d.col, o:GetHash())
            end
        end
    end
end)

