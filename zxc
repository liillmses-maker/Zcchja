-- ================== ESP SYSTEM (GLOBAL) ==================
local Circles={}; local TextLabels={}; local AnimTime=0
local ObjectCache={}; local NPCObjects={}; local ItemObjects={}

function GetCircle()
    for _,c in ipairs(Circles) do if not c.Visible then return c end end
    if Drawing then local c=Drawing.new("Circle"); c.Thickness=2; c.Filled=false; c.Transparency=1; c.NumSides=32; table.insert(Circles,c); return c end
    return nil
end

function GetText()
    for _,t in ipairs(TextLabels) do if not t.Visible then return t end end
    if Drawing then local t=Drawing.new("Text"); t.Size=13; t.Center=true; t.Outline=true; t.OutlineColor=Color3.new(); table.insert(TextLabels,t); return t end
    return nil
end

local function GetState(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("BasePart") then return{p=obj.Position,s=obj.Size,c=obj.Color,m=obj.Material,t=obj.Transparency} end
    local pp=obj:FindFirstChildOfClass("BasePart")or obj.PrimaryPart; if pp then return{p=pp.Position,s=pp.Size} end
    return nil
end

local function HasChanged(old,new)
    if not old or not new then return true end
    if old.p and new.p and(old.p-new.p).Magnitude>0.1 then return true end
    if old.s and new.s and(old.s-new.s).Magnitude>0.1 then return true end
    if old.c and new.c and old.c~=new.c then return true end
    if old.m and new.m and old.m~=new.m then return true end
    if old.t and new.t and math.abs(old.t-new.t)>0.01 then return true end
    return false
end

local function IsKnownMonster(name)
    for _,k in ipairs(KNOWN_MONSTERS) do if name==k then return true end end
    return false
end

local function IsNPC(obj)
    if obj:IsA("Model") then
        if obj:FindFirstChildOfClass("Humanoid") then return true end
        if obj:FindFirstChild("HumanoidRootPart") then return true end
        if IsKnownMonster(obj.Name) then return true end
    end
    return false
end

local function GetPart(obj) return obj:IsA("BasePart")and obj or obj:FindFirstChildOfClass("BasePart")or obj.PrimaryPart end

local function GetChangeType(old,new)
    if not old or not new then return"NEW" end
    local t={}
    if old.p and new.p and(old.p-new.p).Magnitude>0.1 then t[#t+1]="Moved" end
    if old.s and new.s and(old.s-new.s).Magnitude>0.1 then t[#t+1]="Resized" end
    if old.c and new.c and old.c~=new.c then t[#t+1]="Color" end
    if old.m and new.m and old.m~=new.m then t[#t+1]="Material" end
    return#t>0 and table.concat(t,"+")or"Changed"
end

