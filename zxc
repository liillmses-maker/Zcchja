-- ================== QUATERNION ==================
local function QuaternionFromCFrame(cf)
    local _,_,_,m11,m12,m13,m21,m22,m23,m31,m32,m33=cf:GetComponents()
    local w=math.sqrt(math.max(0,1+m11+m22+m33))/2
    local x=math.sqrt(math.max(0,1+m11-m22-m33))/2
    local y=math.sqrt(math.max(0,1-m11+m22-m33))/2
    local z=math.sqrt(math.max(0,1-m11-m22+m33))/2
    x=m32-m23>0 and math.abs(x)or -math.abs(x)
    y=m13-m31>0 and math.abs(y)or -math.abs(y)
    z=m21-m12>0 and math.abs(z)or -math.abs(z)
    return{x=x,y=y,z=z,w=w}
end
local function RotationDiff(q1,q2) if not q1 or not q2 then return 0 end;local dot=q1.x*q2.x+q1.y*q2.y+q1.z*q2.z+q1.w*q2.w;dot=math.clamp(dot,-1,1);return 2*math.acos(math.abs(dot))end

