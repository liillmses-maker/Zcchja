                            local r=math.clamp(math.max(data.size.X,data.size.Y,data.size.Z)*0.7,5,30)
                            cr.Position=Vector2.new(pos.X,pos.Y);cr.Radius=r;cr.Color=data.color;cr.Visible=true
                            txt.Position=Vector2.new(pos.X,pos.Y-r-12)
                            txt.Text=data.name.."\n"..data.room.." | "..data.type;txt.Color=C.WHITE;txt.Visible=true
                        end
                    end
                end
            end
        end
        
        -- DRAW MISSING
        for obj,data in pairs(Missing)do
            if now-data.time<5 then
                if data.pos then
                    local pos,on=Camera:WorldToViewportPoint(data.pos)
                    if on and root and(data.pos-root.Position).Magnitude<100 then
                        local cr=GC();local txt=GT()
                        if cr then
                            local room=GR(data.pos)
                            cr.Position=Vector2.new(pos.X,pos.Y);cr.Radius=10;cr.Color=C.RED;cr.Visible=true
                            txt.Position=Vector2.new(pos.X,pos.Y-14)
                            txt.Text="MISSING\n"..room.." | "..data.name;txt.Color=C.RED;txt.Visible=true
                        end
                    end
                end
            end
        end
    end
    
    -- CLEANUP
    for obj,data in pairs(Detected)do if now-data.time>5 then Detected[obj]=nil end end
    for obj,data in pairs(Missing)do if now-data.time>8 then Missing[obj]=nil end end
end)

