-- ================== RENDER LOOP ==================
RunService.RenderStepped:Connect(function(dt)
    AnimTime=AnimTime+dt
    if not MasterOn then for _,c in ipairs(Circles)do c.Visible=false end;for _,t in ipairs(TextLabels)do t.Visible=false end;return end
    for _,c in ipairs(Circles)do c.Visible=false end;for _,t in ipairs(TextLabels)do t.Visible=false end
    
    local root=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    
    -- MONSTERS
    if Settings.ShowNPC then
        for obj,data in pairs(MonsterObjects)do
            if obj and obj.Parent then
                local part=GetPart(obj)
                if part then
                    local pos,on=Camera:WorldToViewportPoint(part.Position)
                    if on and root and(part.Position-root.Position).Magnitude<150 then
                        local cr=GetCircle();local txt=GetText()
                        if cr and txt then
                            local r=math.clamp(math.max(part.Size.X,part.Size.Y,part.Size.Z)*0.7,6,35)
                            local room=GetRoom(part.Position)
                            local dist=math.floor((part.Position-root.Position).Magnitude)
                            local vel=part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
                            local status=vel.Magnitude>0.3 and"ACTIVE"or"IDLE"
                            cr.Position=Vector2.new(pos.X,pos.Y);cr.Radius=r;cr.Color=C.RED;cr.Visible=true
                            txt.Position=Vector2.new(pos.X,pos.Y-r-16)
                            txt.Text="R "..data.name.."\n"..room.." | "..status.." | "..dist.."m"
                            txt.Color=C.WHITE;txt.Visible=true
                        end
                    end
                end
            end
        end
    end
    
    -- CHANGES
    if Settings.ShowChanges then
        for obj,oldSt in pairs(WorldState)do
            if obj and obj.Parent then
                local newSt=GetFullState(obj)
                if newSt then
                    local changes=CompareStates(oldSt,newSt)
                    if changes then
                        WorldState[obj]=newSt
                        local part=GetPart(obj);if not part then continue end
                        local pos,on=Camera:WorldToViewportPoint(part.Position)
                        if on and root and(part.Position-root.Position).Magnitude<100 then
                            local cr=GetCircle();local txt=GetText()
                            if cr and txt then
                                local r=math.clamp(math.max(part.Size.X,part.Size.Y,part.Size.Z)*0.7,5,30)
                                local room=GetRoom(part.Position)
                                local ctype=table.concat(changes,"+")
                                local col=ctype:find("APPEARED")and C.GREEN or C.YELLOW
                                cr.Position=Vector2.new(pos.X,pos.Y);cr.Radius=r;cr.Color=col;cr.Visible=true
                                txt.Position=Vector2.new(pos.X,pos.Y-r-14)
                                txt.Text=obj.Name.."\n"..room.." | "..ctype;txt.Color=C.WHITE;txt.Visible=true
                                
                                ShowNotification("ANOMALY CHANGED",obj.Name.."\nRoom: "..room.." | "..ctype,C.YELLOW)
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- MISSING
    local now=tick()
    for obj,data in pairs(MissingObjects)do
        if now-data.time<8 then
            local pos=data.state and data.state.pos
            if pos then
                local pos2,on=Camera:WorldToViewportPoint(pos)
                if on and root and(pos-root.Position).Magnitude<100 then
                    local cr=GetCircle();local txt=GetText()
                    if cr and txt then
                        local room=GetRoom(pos)
                        cr.Position=Vector2.new(pos2.X,pos2.Y);cr.Radius=10;cr.Color=C.RED;cr.Visible=true
                        txt.Position=Vector2.new(pos2.X,pos2.Y-14)
                        txt.Text="MISSING\n"..room.." | "..data.state.name;txt.Color=C.RED;txt.Visible=true
                    end
                end
            end
        else MissingObjects[obj]=nil end
    end
end)

