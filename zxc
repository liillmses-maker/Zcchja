    -- ================== EVENT-BASED ESP SYSTEM ==================
    local Circles = {}
    local AnimTime = 0
    local ObjectCache = {}
    local NPCObjects = {}
    local ItemObjects = {}
    
    function GetCircle()
        for _,c in ipairs(Circles) do if not c.Visible then return c end end
        if Drawing then local c=Drawing.new("Circle"); c.Thickness=2; c.Filled=false; c.Transparency=1; c.NumSides=32; table.insert(Circles,c); return c end
        return nil
    end
    
    local function GetState(obj)
        if not obj or not obj.Parent then return nil end
        if obj:IsA("BasePart") then return{p=obj.Position,s=obj.Size,c=obj.Color,m=obj.Material,t=obj.Transparency} end
        local pp=obj:FindFirstChildOfClass("BasePart")or obj.PrimaryPart
        if pp then return{p=pp.Position,s=pp.Size} end
        return nil
    end
    
    local function HasChanged(old,new)
        if not old or not new then return true end
        if old.p and new.p and(old.p-new.p).Magnitude>0.1 then return true end
        if old.s and new.s and(old.s-new.s).Magnitude>0.1 then return true end
        if old.c and new.c and old.c~=new.c then return true end
        if old.m and new.m and old.m~=new.m then return true end
        if old.t and new.t and math.abs(old.t-new.t)>0.01 then return true end
        return false
    end
    
    local function IsNPC(obj)
        if obj:IsA("Model") then
            if obj:FindFirstChildOfClass("Humanoid") then return true end
            if obj:FindFirstChild("HumanoidRootPart") then return true end
        end
        return false
    end
    
    local function GetPart(obj)
        return obj:IsA("BasePart")and obj or obj:FindFirstChildOfClass("BasePart")or obj.PrimaryPart
    end
    
    -- ================== EVENT: OBJECT ADDED ==================
    workspace.DescendantAdded:Connect(function(obj)
        if not MasterOn then return end
        if not(obj:IsA("Model")or obj:IsA("BasePart"))then return end
        if obj:IsA("BasePart")and obj.Transparency>0.95 then return end
        
        local st=GetState(obj)
        if st then ObjectCache[obj]=st end
        
        if IsNPC(obj) then
            NPCObjects[obj]=true
            if Settings.ShowNotify then AddLog("[NPC] "..obj.Name.." spawned",C.RED) end
        elseif Settings.ItemMode then
            ItemObjects[obj]={st=st,changed=false,time=tick()}
            if Settings.ShowNotify then
                local part=GetPart(obj); local room=part and GetRoom(part.Position)or"?"
                AddLog("[NEW] ["..room.."] "..obj.Name,C.PINK_ESP)
            end
        end
    end)
    
    -- ================== EVENT: OBJECT REMOVED ==================
    workspace.DescendantRemoving:Connect(function(obj)
        if NPCObjects[obj] then
            NPCObjects[obj]=nil
            if Settings.ShowNotify then AddLog("[NPC] "..obj.Name.." removed",C.RED) end
        end
        if ItemObjects[obj] then
            local data=ItemObjects[obj]
            if data and data.st then
                local part=GetPart(obj); local room=part and GetRoom(part.Position)or"?"
                if Settings.ShowNotify then AddLog("[REMOVED] ["..room.."] "..obj.Name,C.ORANGE) end
            end
            ItemObjects[obj]=nil
        end
        ObjectCache[obj]=nil
    end)
    
    -- ================== PERIODIC CHANGE CHECK (LIGHT) ==================
    spawn(function()
        while Main and Main.Parent do
            wait(0.5)
            if MasterOn and Settings.ItemMode then
                for obj,data in pairs(ItemObjects) do
                    if obj and obj.Parent then
                        local st=GetState(obj)
                        if st and data.st then
                            if HasChanged(data.st,st) then
                                data.changed=true; data.st=st; data.time=tick()
                                local part=GetPart(obj); local room=part and GetRoom(part.Position)or"?"
                                if Settings.ShowNotify then AddLog("[CHANGE] ["..room.."] "..obj.Name,C.GREEN) end
                            end
                        elseif st then
                            data.st=st
                        end
                    else
                        ItemObjects[obj]=nil
                    end
                end
                -- Remove stable items after 5 seconds
                local now=tick()
                for obj,data in pairs(ItemObjects) do
                    if not data.changed and now-data.time>5 then
                        ItemObjects[obj]=nil
                    end
                end
            end
        end
    end)
    
    -- ================== RENDER LOOP (LIGHT) ==================
    RunService.RenderStepped:Connect(function(dt)
        AnimTime=AnimTime+dt
        
        if MasterOn then
            for _,c in ipairs(Circles) do c.Visible=false end
            
            -- Draw NPCs (RED)
            if Settings.NPCMode then
                for obj in pairs(NPCObjects) do
                    if obj and obj.Parent then
                        local part=GetPart(obj)
                        if part then
                            local pos,on=Camera:WorldToViewportPoint(part.Position)
                            if on then
                                local cr=GetCircle()
                                if cr then
                                    local r=math.clamp(math.max(part.Size.X,part.Size.Y,part.Size.Z)*0.7,4,35)
                                    cr.Position=Vector2.new(pos.X,pos.Y)
                                    cr.Radius=r*(1+math.sin(AnimTime*2+(string.byte(obj.Name,1)or 1))*0.04)
                                    cr.Color=C.RED; cr.Visible=true
                                end
                            end
                        end
                    end
                end
            end
            
            -- Draw Items (PINK)
            if Settings.ItemMode then
                for obj,data in pairs(ItemObjects) do
                    if obj and obj.Parent then
                        local part=GetPart(obj)
                        if part then
                            local pos,on=Camera:WorldToViewportPoint(part.Position)
                            if on then
                                local cr=GetCircle()
                                if cr then
                                    local r=math.clamp(math.max(part.Size.X,part.Size.Y,part.Size.Z)*0.7,4,35)
                                    cr.Position=Vector2.new(pos.X,pos.Y)
                                    cr.Radius=r*(1+math.sin(AnimTime*2+(string.byte(obj.Name,1)or 1))*0.04)
                                    cr.Color=data.changed and C.GREEN or C.PINK_ESP; cr.Visible=true
                                end
                            end
                        end
                    end
                end
            end
        else
            for _,c in ipairs(Circles) do c.Visible=false end
        end
        
        local nc,ic=0,0
        for _ in pairs(NPCObjects) do nc=nc+1 end
        for _ in pairs(ItemObjects) do ic=ic+1 end
        StatusText.Text=MasterOn and("NPC:"..nc.." ITEM:"..ic)or"=;= Idle"
        StatusText.TextColor3=MasterOn and C.PINK or C.GRAY
    end)
    
    -- Scanner
    spawn(function()
        while Main and Main.Parent do
            wait(0.5)
            if MasterOn and Settings.Scanner then
                for obj,oldSt in pairs(ObjectCache) do
                    if obj and obj.Parent and obj:IsA("BasePart")then
                        local st=GetState(obj)
                        if st then
                            if Settings.SkinDetect and oldSt and(oldSt.c~=st.c or oldSt.m~=st.m)then AddLog("[SKIN] ["..GetRoom(obj.Position).."] "..obj.Name,C.PINK) end
                            if Settings.SizeDetect and oldSt and(oldSt.s-st.s).Magnitude>0.1 then AddLog("[SIZE] ["..GetRoom(obj.Position).."] "..obj.Name,C.YELLOW) end
                            ObjectCache[obj]=st
                        end
                    end
                end
            end
        end
    end)
end

