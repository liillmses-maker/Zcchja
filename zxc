local function ToggleRow(page,name,default,cb)
    local enabled = default
    local Row=Instance.new("Frame"); Row.Size=UDim2.new(1,0,0,18); Row.BackgroundColor3=C.BG2; Row.BorderSizePixel=0; Row.Parent=page
    local Lbl=Instance.new("TextLabel"); Lbl.Size=UDim2.new(0.45,0,1,0); Lbl.Position=UDim2.new(0,4,0,0); Lbl.Text=name
    Lbl.TextColor3=C.GRAY; Lbl.Font=Enum.Font.Gotham; Lbl.TextSize=8; Lbl.BackgroundTransparency=1; Lbl.TextXAlignment=Enum.TextXAlignment.Left; Lbl.Parent=Row
    
    local CatBtn=Instance.new("TextButton"); CatBtn.Size=UDim2.new(0,32,0,14); CatBtn.Position=UDim2.new(1,-36,0.5,-7)
    CatBtn.Text = "=;="; CatBtn.BackgroundColor3 = C.OFF; CatBtn.TextColor3 = C.GRAY
    CatBtn.Font=Enum.Font.GothamBold; CatBtn.TextSize=7; CatBtn.BorderSizePixel=0; CatBtn.Parent=Row
    Instance.new("UICorner",CatBtn).CornerRadius=UDim.new(1,0)
    
    local function Set(s)
        enabled = s
        if s then
            CatBtn.Text = "=^^="
            CatBtn.BackgroundColor3 = C.ON
            CatBtn.TextColor3 = C.WHITE
            Lbl.TextColor3 = C.WHITE
        else
            CatBtn.Text = "=;="
            CatBtn.BackgroundColor3 = C.OFF
            CatBtn.TextColor3 = C.GRAY
            Lbl.TextColor3 = C.GRAY
        end
    end
    
    CatBtn.MouseButton1Click:Connect(function()
        Set(not enabled)
        cb(not enabled)
    end)
    
    Set(default)
end

