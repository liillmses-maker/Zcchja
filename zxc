local function Chgd(o,n) if not o or not n then return true end; if o.p and n.p and(o.p-n.p).Magnitude>0.1 then return true end; if o.r and n.r and(o.r-n.r).Magnitude>0.5 then return true end; if o.s and n.s and(o.s-n.s).Magnitude>0.1 then return true end; if o.c and n.c and o.c~=n.c then return true end; if o.t and n.t and math.abs(o.t-n.t)>0.01 then return true end; if o.m and n.m and o.m~=n.m then return true end; return false end
local function CT(o,n) local c={}; if o.p and n.p and(o.p-n.p).Magnitude>0.1 then table.insert(c,"MOVED") end; if o.r and n.r and(o.r-n.r).Magnitude>0.5 then table.insert(c,"ROTATED") end; if o.s and n.s and(o.s-n.s).Magnitude>0.1 then table.insert(c,"RESIZED") end; if o.c and n.c and o.c~=n.c then table.insert(c,"COLOR") end; if o.m and n.m and o.m~=n.m then table.insert(c,"MATERIAL") end; return #c>0 and table.concat(c,"+")or"CHANGED" end

-- MAIN LOOP
RunService.RenderStepped:Connect(function(dt)
    if MasterOn and(Settings.AnomalyESP or Settings.ObjectESP or Settings.ChangesESP) then
        ESPLastScan=ESPLastScan+dt
        if ESPLastScan>=ESPInterval then ESPLastScan=0; DetectedESP={}
            for _,o in ipairs(workspace:GetDescendants()) do if not(o:IsA("Model")or o:IsA("BasePart"))then continue end; local nm=o.Name; local ok=false; local col=C.PINK_ESP
                if Settings.AnomalyESP and InList(nm,ANOMALY_NAMES) then ok=true; col=C.RED
                elseif Settings.ObjectESP and InList(nm,OBJECT_NAMES) then ok=true; col=C.PINK_ESP
                elseif Settings.ChangesESP then local p=o:IsA("BasePart")and o or o:FindFirstChildOfClass("BasePart"); if p and p:IsA("BasePart")and(p.Velocity.Magnitude>0.1 or p.RotVelocity.Magnitude>0.1) then ok=true; col=C.YELLOW end end
                if ok then DetectedESP[o]=col end
            end
        end
        for _,l in ipairs(LinePool) do l.Visible=false end
        for o,col in pairs(DetectedESP) do if o and o.Parent then if o:IsA("Model") then for _,c in ipairs(o:GetDescendants()) do if c:IsA("BasePart") then DrawWire(c,col) end end elseif o:IsA("BasePart") then DrawWire(o,col) end end end
    else for _,l in ipairs(LinePool) do l.Visible=false end end
    
    if not Settings.Scanner then if MasterOn then Status.Text="uwu on" else Status.Text="uwu zzz..." end; return end
    ScLs=ScLs+dt; LsCp=LsCp+dt; LsSo=LsSo+dt; LsCl=LsCl+dt; LsFa=LsFa+dt
