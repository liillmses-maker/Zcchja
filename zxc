local ROOMS = {
    "Living Room", "LivingRoom", "Garage", "Downstairs Bathroom", "Downstairs Hall",
    "Study", "Kitchen", "Basement", "Master Bedroom", "Nursery",
    "Upstairs Bathroom", "Storage Room", "Upstairs Hall", "Upstairs Hallway",
    "Movie Room", "Projector Room", "Guest Room", "Guest Bedroom",
    "Bedroom", "Playroom", "Yard"
}

local function GetRoomName(obj)
    local current = obj
    while current do
        for _, room in ipairs(ROOMS) do
            if current.Name == room then return room end
        end
        current = current.Parent
    end
    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
    if part then
        for _, child in ipairs(workspace:GetDescendants()) do
            for _, room in ipairs(ROOMS) do
                if child.Name == room and child:IsA("BasePart") then
                    if (part.Position - child.Position).Magnitude < 30 then return room end
                end
            end
        end
    end
    return "?"
end

