    local cf = part.CFrame; local s = part.Size/2
    return {
        cf*Vector3.new(-s.X,-s.Y,-s.Z), cf*Vector3.new(s.X,-s.Y,-s.Z),
        cf*Vector3.new(s.X,-s.Y,s.Z), cf*Vector3.new(-s.X,-s.Y,s.Z),
        cf*Vector3.new(-s.X,s.Y,-s.Z), cf*Vector3.new(s.X,s.Y,-s.Z),
        cf*Vector3.new(s.X,s.Y,s.Z), cf*Vector3.new(-s.X,s.Y,s.Z)
    }
end

local function DrawWireframe(part,color)
    local corners = GetCorners(part)
    local edges = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
    for _,e in ipairs(edges) do
        local p1 = Camera:WorldToViewportPoint(corners[e[1]])
        local p2 = Camera:WorldToViewportPoint(corners[e[2]])
        if p1.Z>0 and p2.Z>0 then
            local l = GetLine(); l.From=Vector2.new(p1.X,p1.Y); l.To=Vector2.new(p2.X,p2.Y)
            l.Color=color; l.Visible=true
        end
    end
end

local function InList(name,list)
    for _,k in ipairs(list) do if name==k then return true end end
    return false
end

-- ================== MAIN LOOP ==================
RunService.RenderStepped:Connect(function(dt)
    -- ========== ESP ==========
    if MasterOn and (Settings.AnomalyESP or Settings.ObjectESP or Settings.ChangesESP) then
        ESPLastScan = ESPLastScan + dt
        if ESPLastScan >= ESPInterval then
            ESPLastScan = 0
            DetectedESP = {}
            for _,obj in ipairs(workspace:GetDescendants()) do
                if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
                local name = obj.Name
                local ok = false; local col = C.PINK_ESP
                
                if Settings.AnomalyESP and InList(name,ANOMALY_NAMES) then
                    ok=true; col=C.RED
                elseif Settings.ObjectESP and InList(name,OBJECT_NAMES) then
                    ok=true; col=C.PINK_ESP
                elseif Settings.ChangesESP then
                    local p = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
                    if p and p:IsA("BasePart") and (p.Velocity.Magnitude>0.1 or p.RotVelocity.Magnitude>0.1) then
                        ok=true; col=C.YELLOW
                    end
                end
                
                if ok then DetectedESP[obj] = col end
            end
        end
        
        for _,l in ipairs(LinePool) do l.Visible=false end
        for obj,col in pairs(DetectedESP) do
            if obj and obj.Parent then
                if obj:IsA("Model") then
                    for _,c in ipairs(obj:GetDescendants()) do
                        if c:IsA("BasePart") then DrawWireframe(c,col) end
                    end
                elseif obj:IsA("BasePart") then
                    DrawWireframe(obj,col)
                end
            end
        end
    else
        for _,l in ipairs(LinePool) do l.Visible=false end
    end
    
    -- ========== SCANNER ==========
    if not Settings.Scanner then
        if MasterOn then Status.Text = "uwu on" else Status.Text = "uwu zzz..." end
        return
    end
    
    LastScan = LastScan + dt
    LastCopy = LastCopy + dt
    LastSoundCheck = LastSoundCheck + dt
    LastClockCheck = LastClockCheck + dt
    LastFaceCheck = LastFaceCheck + dt

    if Settings.DetectSounds and LastSoundCheck >= 1 then
        LastSoundCheck = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Sound") and obj.IsPlaying and obj.Volume > 0.05 then
                local id = obj:GetFullName()
                if not SoundReported[id] then
                    SoundReported[id] = true
                    local room = GetRoomName(obj)
                    local sid = obj.SoundId or "unknown"
                    local sname = sid:match("([^/]+)$") or sid
                    local msg = "[S] [" .. room .. "] " .. sname
                    table.insert(CopiedChanges, msg)
                    AddLog(msg, C.CYAN)
                end
            end
        end
        for id in pairs(SoundReported) do
            local obj = workspace:FindFirstChild(id)
            if not obj or not obj:IsA("Sound") or not obj.IsPlaying then SoundReported[id] = nil end
        end
    end

    if Settings.DetectClock and LastClockCheck >= 0.5 then
        LastClockCheck = 0
        local currentTime = Lighting.ClockTime
        local timeDiff = math.abs(currentTime - PrevClockTime)
        if timeDiff > 0.08 then
            local msg = "[CLOCK] x" .. math.floor(timeDiff / 0.03)
            table.insert(CopiedChanges, msg)
            AddLog(msg, Color3.new(1, 0.588, 0.196))
        end
        PrevClockTime = currentTime
    end

    if Settings.DetectFaces and LastFaceCheck >= 0.5 then
        LastFaceCheck = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            local name = obj.Name:lower()
            if name:find("annoying") or name:find("orange") or name:find("painting") or name:find("mona") then
                local hasDecal = false
                for _, child in ipairs(obj:GetDescendants()) do
                    if child:IsA("Decal") or child:IsA("Texture") then hasDecal = true; break end
                end
                if hasDecal and not obj:GetAttribute("FaceReported") then
                    obj:SetAttribute("FaceReported", true)
                    local room = GetRoomName(obj)
                    local msg = "[FACE] [" .. room .. "] " .. obj.Name
                    table.insert(CopiedChanges, msg)
                    AddLog(msg, Color3.new(1, 0.392, 1))
                end
            end
        end
    end

    if LastScan >= 0.5 then
        LastScan = 0
        local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local currentObjects = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
            if obj:IsA("BasePart") and obj.Transparency > 0.95 then continue end
            if obj.Name == "Terrain" then continue end
            if IsBodyPart(obj.Name) then continue end
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
            if not part then continue end
            if (part.Position - root.Position).Magnitude > Settings.ScanRange then continue end
            local state = GetObjectState(obj)
            if not state then continue end
            currentObjects[obj] = state

            if ObjectDB[obj] and HasStateChanged(ObjectDB[obj], state) then
                local room = GetRoomName(obj)
                local changeType = GetChangeType(ObjectDB[obj], state)
                local msg = "[" .. room .. "] " .. obj.Name .. ": " .. changeType
                table.insert(CopiedChanges, msg)
                AddLog(msg, C.YELLOW)
            end
        end

        for obj in pairs(ObjectDB) do
            if not currentObjects[obj] and not IsBodyPart(obj.Name) then
                local room = GetRoomName(obj)
                local msg = "[-] [" .. room .. "] " .. obj.Name
                table.insert(CopiedChanges, msg)
                AddLog(msg, C.RED)
            end
        end

        ObjectDB = currentObjects

        if Settings.AutoCopy and #CopiedChanges > 0 and LastCopy >= 5 and setclipboard then
            LastCopy = 0
            local seen = {}
            local text = ""
            for _, v in ipairs(CopiedChanges) do
                if not seen[v] then seen[v] = true; text = text .. v .. "\n" end
            end
            setclipboard(text)
            CopiedChanges = {}
            Status.Text = "copied!"
            Status.TextColor3 = C.GREEN
            spawn(function() wait(2) Status.TextColor3 = C.GRAY end)
        end

        local total = 0
        for _ in pairs(ObjectDB) do total = total + 1 end
        Status.Text = "~" .. total .. " obj"
    end
end)

