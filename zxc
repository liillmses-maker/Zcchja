-- ================== BASELINE + DETECT ==================
local BaseLine={}
local function ProcessAnomaly(obj,anomalyType) if not CanAlert(obj,anomalyType)then return end;local config=AnomalyConfig[anomalyType];if not config then return end;highlight(obj,config.color);createLabel(obj,config.label,config.color)end

local function TakeSnapshot(obj)
    local part=getPart(obj)if not part then return end
    if not BaseLine[obj]then BaseLine[obj]=State.new(obj)end
    BaseLine[obj]:Snapshot({pos=part.Position,size=part.Size,color=part:IsA("BasePart")and part.Color or nil,material=part:IsA("BasePart")and part.Material or nil,transparency=part:IsA("BasePart")and part.Transparency or nil,anchored=part:IsA("BasePart")and part.Anchored or nil,quaternion=QuaternionFromCFrame(part.CFrame),texture=obj:IsA("Decal")and obj.Texture or obj:IsA("Texture")and obj.Texture or nil,brightness=obj:IsA("Light")and obj.Brightness or nil,soundId=obj:IsA("Sound")and obj.SoundId or nil,childCount=obj:IsA("Model")and#obj:GetChildren()or nil,parent=obj.Parent})
end

local function DetectChanges(obj)
    local state=BaseLine[obj]if not state or not state.last then return end;if not obj.Parent then BaseLine[obj]=nil;return end
    local part=getPart(obj)if not part then return end;local base=state.last
    if base.quaternion then local newQ=QuaternionFromCFrame(part.CFrame)if RotationDiff(base.quaternion,newQ)>0.05 then ProcessAnomaly(obj,"ROTATED")base.quaternion=newQ end end
    if(part.Position-base.pos).Magnitude>1 then ProcessAnomaly(obj,"MOVED")base.pos=part.Position end
    if base.size and(part.Size-base.size).Magnitude>0.3 then ProcessAnomaly(obj,"SIZE")base.size=part.Size end
    if base.color and part:IsA("BasePart")and part.Color~=base.color then ProcessAnomaly(obj,"COLOR")base.color=part.Color end
    if base.material and part:IsA("BasePart")and part.Material~=base.material then ProcessAnomaly(obj,"MATERIAL")base.material=part.Material end
    if base.transparency and part:IsA("BasePart")and math.abs(part.Transparency-base.transparency)>0.05 then ProcessAnomaly(obj,"TRANSPARENCY")base.transparency=part.Transparency end
    if base.anchored~=nil and part:IsA("BasePart")and part.Anchored~=base.anchored then ProcessAnomaly(obj,"ANCHORED")base.anchored=part.Anchored end
    if base.brightness and obj:IsA("Light")and math.abs(obj.Brightness-base.brightness)>0.2 then ProcessAnomaly(obj,"LIGHT")base.brightness=obj.Brightness end
    local tex=nil;if obj:IsA("Decal")then tex=obj.Texture elseif obj:IsA("Texture")then tex=obj.Texture end
    if tex and base.texture and tex~=base.texture then ProcessAnomaly(obj,"IMAGE")base.texture=tex end
    if obj:IsA("BasePart")then local gui=obj:FindFirstChildWhichIsA("SurfaceGui")if gui then local img=gui:FindFirstChildWhichIsA("ImageLabel")if img and base.texture and img.Image~=base.texture then ProcessAnomaly(obj,"TV")base.texture=img.Image end end end
    if base.parent and obj.Parent~=base.parent then ProcessAnomaly(obj,"PARENT_CHANGED")base.parent=obj.Parent end
    if base.childCount and obj:IsA("Model")then local count=#obj:GetChildren()if count~=base.childCount then ProcessAnomaly(obj,"CHILD_COUNT")base.childCount=count end end
end

-- ================== HOOKS ==================
local function HookObject(obj)
    if obj:IsA("BasePart")then
        obj:GetPropertyChangedSignal("Position"):Connect(function()task.delay(REPL_DELAY,function()if BaseLine[obj]then DetectChanges(obj)end end)end)
        obj:GetPropertyChangedSignal("Color"):Connect(function()task.delay(REPL_DELAY,function()if BaseLine[obj]then DetectChanges(obj)end end)end)
        obj:GetPropertyChangedSignal("Material"):Connect(function()task.delay(REPL_DELAY,function()if BaseLine[obj]then DetectChanges(obj)end end)end)
        obj:GetPropertyChangedSignal("Transparency"):Connect(function()task.delay(REPL_DELAY,function()if BaseLine[obj]then DetectChanges(obj)end end)end)
        obj:GetPropertyChangedSignal("Anchored"):Connect(function()task.delay(REPL_DELAY,function()if BaseLine[obj]then DetectChanges(obj)end end)end)
        obj:GetPropertyChangedSignal("Size"):Connect(function()task.delay(REPL_DELAY,function()if BaseLine[obj]then DetectChanges(obj)end end)end)
    end
    if obj:IsA("Light")then obj:GetPropertyChangedSignal("Brightness"):Connect(function()task.delay(REPL_DELAY,function()if BaseLine[obj]then DetectChanges(obj)end end)end)end
    if obj:IsA("Decal")or obj:IsA("Texture")then obj:GetPropertyChangedSignal("Texture"):Connect(function()task.delay(REPL_DELAY,function()if BaseLine[obj]then DetectChanges(obj)end end)end)end
    if obj:IsA("Sound")then obj:GetPropertyChangedSignal("SoundId"):Connect(function()task.delay(REPL_DELAY,function()if BaseLine[obj]then DetectChanges(obj)end end)end)end
    obj.AncestryChanged:Connect(function()task.delay(REPL_DELAY,function()if BaseLine[obj]then DetectChanges(obj)end end)end)
    obj.Destroying:Connect(function()if BaseLine[obj]then ProcessAnomaly(obj,"MISSING")BaseLine[obj]=nil end end)
end

