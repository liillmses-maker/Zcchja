local function GetRoomName(o)
    local c=o; while c do for _,r in ipairs(ROOMS) do if c.Name==r then return r end end; c=c.Parent end
    local p=o:IsA("BasePart") and o or o:FindFirstChildOfClass("BasePart")
    if p then for _,ch in ipairs(workspace:GetDescendants()) do for _,r in ipairs(ROOMS) do if ch.Name==r and ch:IsA("BasePart") and (p.Position-ch.Position).Magnitude<30 then return r end end end end
    return "?"
end

