            TweenService:Create(PawBtn, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, IsMobile and 46 or 42, 0, IsMobile and 46 or 42),
                BackgroundColor3 = C.ON,
                TextColor3 = C.WHITE
            }):Play()
            TweenService:Create(Glow, TweenInfo.new(0.4), {BackgroundTransparency = 0.5}):Play()
            TweenService:Create(Dot, TweenInfo.new(0.3), {BackgroundColor3 = C.ON}):Play()
            TweenService:Create(Label, TweenInfo.new(0.3), {TextColor3 = C.WHITE}):Play()
        else
            -- OFF: sleepy closed paws =.=
            PawBtn.Text = "=.="
            TweenService:Create(PawBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
