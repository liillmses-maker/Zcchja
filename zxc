                if newSt and ObjectDB[o] and(ObjectDB[o].s-newSt.s).Magnitude>0.1 then
                    ShowNotif("SIZE",o.Name,C.YELLOW); AddLog("[SIZE] "..o.Name.." changed",C.YELLOW)
                end
                ObjectDB[o]=newSt
            end
        end
    end
    
    if MasterOn then StatusLabel.Text="uwu on" else StatusLabel.Text="uwu zzz..." end
